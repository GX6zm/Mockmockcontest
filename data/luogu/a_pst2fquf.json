<!DOCTYPE html>
<html lang="zh-CN" class="no-js">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="renderer" content="webkit">
    <link rel="icon" href="https://fecdn.luogu.com.cn/favicon.ico">
    <title>安全访问中心 - 洛谷</title>
    <style>
        html, body { padding: 0; margin: 0; font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, "San Francisco", "Helvetica Neue", "Noto Sans", "Noto Sans CJK SC", "Noto Sans CJK", "Source Han Sans", "PingFang SC", "Segoe UI", "Microsoft YaHei", sans-serif; }
        h3 { font-size: 1.25em; font-weight: normal; }
        .card { text-align: center; padding: 2em 3em; }
        .card > * { margin: .75em 0; }
        pre { box-sizing: border-box; width: 100%; max-width: 100%; border-radius: 2px; border: 1px solid; padding: .5em; overflow-wrap: break-word; white-space: normal; }
        .submit, button { border: none; color: #fff; font-size: inherit; line-height: normal; -webkit-appearance: none; appearance: none; cursor: pointer; padding: .5em 1em; border-radius: 3px; background: #3498db; }

        html, body { background-color: #f2f2f2; color: #333; }
        .card { background-color: #fff; box-shadow: 0 1px 3px rgba(26, 26, 26, .1); }
        pre { border-color: #bfbfbf; background: #fafafa;  }
        @media (prefers-color-scheme: dark) {
            html, body { background-color: #000; color: #eee; }
            .card { background-color: #333; box-shadow: 0 1px 3px rgba(224, 224, 224, .3); }
            pre { border-color: #bfbfbf; background: #202020;  }
        }

        
    </style>
    </head>
<body>
    <div style="margin: 0 auto; width: 100vw; padding: 2em 0; box-sizing: border-box; max-width: 680px; height: 100%; min-height: 100vh; display: flex; flex-flow: column; justify-content: center;">
        <div class="card">
            <p><img src="https://fecdn.luogu.com.cn/logo.png" style="width: 120px;"></p>
            <h3>即将离开洛谷</h3>
            <p style="padding: 0 3em;">你访问的网站可能包含未知的安全风险，如需继续访问，请复制链接访问或点击按钮确认，并注意保护账号和隐私信息。</p>
            <pre id="url">https://www.luogu.com/article/pst2fquf</pre>
            <p><a href="https://www.luogu.com/article/pst2fquf"><button id="go">继续访问</button></a></p>
        </div>
    </div>
    <script>
        var $url = document.getElementById('url'), $go = document.getElementById('go');
        function selectAll($) {
            if(!window.getSelection) return;
            var range = document.createRange(), sel = window.getSelection();
            range.selectNode($); sel.removeAllRanges(); sel.addRange(range);
        }
        $url.addEventListener('mouseover', function () { selectAll(this); });
        $url.addEventListener('click', function () {
            selectAll(this);
            var success = function () { var t = $go.innerHTML; $go.innerHTML = '复制成功！'; setTimeout(function () { $go.innerHTML = t; }, 600); };
            if(!navigator.clipboard) {
                if(!document.execCommand('copy')) return;
                return success();
            }
            navigator.clipboard.writeText($url.innerText).then(success);
        });
    </script>
