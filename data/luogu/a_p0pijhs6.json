        <script id="lentille-context" type="application/json">{"instance":"main","template":"article.show","status":200,"locale":"zh-CN","data":{"article":{"lid":"p0pijhs6","title":"CSP2026 \u6e38\u8bb0","category":5,"time":1793579552,"author":{"uid":732804,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/732804.png","name":"Zctf1088","slogan":"\u5c31\u50cf\u98de\u7fd4\u5728\u8fbd\u9614\u5929\u7a7a","badge":null,"isAdmin":false,"isBanned":false,"color":"Orange","ccfLevel":7,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/6m17kfx6.webp"},"upvote":1,"replyCount":0,"favorCount":0,"status":2,"solutionFor":null,"promoteStatus":2,"collection":{"id":230,"name":"CSP2026 \u6e38\u8bb0\u5408\u96c6"},"content":"### 2026.09.16\n\n\u5176\u5b9e\u611f\u89c9 CSP \u6e38\u8bb0\u6ca1\u5565\u5199\u7684\u3002\n\n\u8fd9\u5468\u672b\u662f\u7b2c\u4e00\u8f6e\u3002\n\n\u5e0c\u671b\u8fd9\u8d5b\u5b63\u4e0d\u8981\u6253\u5d29\u3002\n\n\u4e0d\u6253\u5d29 NOIP \u5e94\u8be5\u4e0d\u4f1a\u592a\u70c2\u3002\n\n\u770b\u80fd\u4e0d\u80fd\u51c6\u5907\u4e00\u4e0b\u7701\u9009\u3002\n\n\u9ad8\u4e2d whk \u600e\u4e48\u4f5c\u4e1a\u8fd9\u4e48\u96be\u5199\u3002\n\n\u4f5c\u4e1a\u597d\u591a\u3002\n\n### 2026.10.06\n\n:::info[\u6bd4\u8f83\u5fc3\u6d41\u7684\u4e00\u4e9b\u4e1c\u897f\uff0c\u53ef\u4ee5\u653e\u5fc3\u98df\u7528\u3002]\n\n\u5230\u4e86\u8fd9\u4e48\u4e00\u4e2a\u65f6\u95f4\u70b9\uff0c\u591a\u5c11\u7275\u626f\u5230\u4e00\u4e9b\u5173\u4e8e\u505c\u8bfe\u7684\u4e8b\u60c5\u3002\n\n\u73b0\u5728\u53bb\u770b\uff0c\u6bd4\u8f83\u4e0d\u8ba4\u540c[\u53bb\u5e74\u7684\u81ea\u5df1](https:\/\/www.cnblogs.com\/Zctf1088\/p\/19097523)\u3002\u5bf9\uff0c\u521d\u4e09\u8fd9\u4e00\u5e74\u81f3\u5c11\u8fd9\u4e9b\u4e8b\u6ca1\u767d\u7ecf\u5386\u3002\u4f60\u4e00\u79cd\u8bf4\u6cd5\u662f\u6ca1\u6709\u4e86\u90a3\u79cd\u97e7\u6027\uff0c\u5176\u5b9e\u6211\u89c9\u5f97\u5e94\u8be5\u8bf4\u662f\u4e0d\u662f\u90a3\u4e48\u50bb\u903c\u4e86\uff0c\u4e0d\u729f\u4e86\u3002\u6559\u7ec3\u5bf9\u6211\u8fd9\u4e48\u5b89\u6392\uff0c\u5b9a\u6709\u4ed6\u7684\u9053\u7406\u3002\u663e\u7136\uff0c\u6559\u7ec3\u4e0d\u4e00\u5b9a\u662f\u4eba\u7c7b\u3002\u4f46\u662f\u6211\u5fc5\u987b\u8ba4\u8bc6\u5230\uff0c\u6211\u4e5f\u4e0d\u4e00\u5b9a\u662f\u4eba\u7c7b\u3002\u7ed9\u522b\u4eba\u6240\u8c13\u8d44\u6e90\u800c\u4e0d\u7ed9\u6211\uff0c\u5fc5\u662f\u6211\u8fd8\u6709\u54ea\u91cc\u505a\u7684\u4e0d\u5982\u522b\u4eba\uff0c\u6216\u662f\u6240\u8c13\u6027\u683c\u3001\u8111\u56de\u8def\u3001\u5fc3\u6c14\u3001\u505a\u4e8b\u98ce\u683c\u3001\u4eba\u5404\u6709\u5fd7\u8bf8\u591a\u8bcd\u6c47\uff0c\u90fd\u51fa\u81ea\u6559\u7ec3\u4e4b\u53e3\uff0c\u5927\u6982\u8bf4\u7684\u90fd\u662f\u76f8\u4f3c\u7684\u610f\u601d\u3002\u6211\u5728\u8fd9\u65b9\u9762\u4e0a\u663e\u7136\u548c\u4ed6\u4eba\u5b58\u5728\u4e00\u5b9a\u5dee\u8ddd\uff0c\u8fd9\u662f\u6211\u4e0d\u5f97\u4e0d\u627f\u8ba4\u7684\u3002\u6211\u5e94\u5f53\u60f3\u7684\uff0c\u4e0d\u662f\u53bb\u62b1\u6028\uff0c\u4e0d\u662f\u53bb\u601d\u8003\u4e3a\u4ec0\u4e48\u6211\u6ca1\u6709\u8fd9\u6837\u6240\u8c13\u8d44\u6e90\uff0c\u800c\u662f\u53bb\u52aa\u529b\uff0c\u5982\u679c\u60f3\u8981\u5f97\u5230\u5c31\u53bb\u4e89\u53d6\uff0c\u5426\u5219\u5c31\u4e0d\u8981\u53bb\u65e5\u601d\u591c\u60f3\uff0c\u4e0d\u8981\u7ec8\u65e5\u505a\u4e00\u4e2a\u201c\u7a7a\u60f3\u5bb6\u201d\u3002\n\n\u55ef\uff0c\u5728\u524d\u4e9b\u65e5\u5b50\uff0c\u6559\u7ec3\u7ed9\u521d\u4e2d\u7684\u505c\u8bfe\u4e86\u4f46\u662f\u6ca1\u6709\u7ed9\u6211\u4eec\u505c\u8bfe\u3002\u4ed6\u5e94\u8be5\u662f\u60f3\u8ba9\u6211\u4eec\u53bb\u53c2\u52a0\u5b66\u6821\u7684\u8fd0\u52a8\u4f1a\u5427\u3002\u55ef\u2026\u2026\u5bf9\u5427\u3002\u5bf9\u7684\uff0c\u6211\u5176\u5b9e\u662f\u4e00\u4e2a\u5f88\u5f31\u7684\u4eba\uff0c\u6211\u5fc5\u987b\u627f\u8ba4\u5e76\u63a5\u6536\u8fd9\u4e2a\u4e8b\u5b9e\uff0c\u8868\u9762\u4e0a\u7684\u9636\u6bb5\u5185\u6bd4\u90e8\u5206\u540c\u5b66\u8981\u8868\u73b0\u5730\u5f3a\u53ea\u4e0d\u8fc7\u662f\u56e0\u4e3a\u5f00\u59cb\u5f97\u6bd4\u4ed6\u4eec\u65e9\uff0c\u5982\u4eca\u5df2\u7ecf\u88ab\u82e5\u5e72\u540c\u5b66\u53cd\u8d85\uff0c\u800c\u5c06\u6765\u4e5f\u4f1a\u88ab\u82e5\u5e72\u540c\u5b66\u53cd\u8d85\u3002\u5f53\u7136\u540c\u7406\u7684\uff0c\u4e5f\u4f1a\u6709\u4e00\u4e9b\u76ee\u524d\u8868\u73b0\u5f97\u6bd4\u6211\u5f3a\u7684\u4eba\u5728\u4e00\u5b9a\u65f6\u95f4\u540e\u4e5f\u4f1a\u88ab\u6211\u53cd\u8d85\uff0c\u73b0\u5728\u7684\u5dee\u8ddd\u4e0d\u8fc7\u662f\u5f00\u59cb\u65f6\u95f4\u7684\u5dee\u522b\u3002\n\n\u76d6\u6b64\u4e4b\u8c13\u6027\u683c\u6216\u505a\u4e8b\u98ce\u683c\u4e4b\u7c7b\u3002\n\n\u5982\u679c\u60f3\u8981\u4ece\u6839\u672c\u4e0a\u5f3a\u4e8e\u67d0\u4e2a\u4eba\uff0c\u5fc5\u5148\u4ece\u6240\u8c13\u6027\u683c\u53ca\u505a\u4e8b\u98ce\u683c\u4e0a\u5f3a\u4e8e\u5176\u3002\u8fd9\u4e2a\u662f\u53ef\u4ee5\u63d0\u5347\u7684\u3002\u81f3\u5c11\u4e8e\u6211\uff0c\u81ea\u516d\u5e74\u7ea7\u81f3\u4eca\uff0c\u63d0\u5347\u5de8\u5927\u3002\u6216\u53ef\u8c13\u4e4b\u6210\u957f\u3002\n\n\u672c\u6765\u5c31\u60f3\u778e\u626f\u51e0\u53e5\uff0c\u53c8\u8bf4\u591a\u4e86\u3002\n\n:::\n\n### 2026.10.25\n\n\u4e0b\u5468\u516d\u662f CSP\u3002\u522b\u6253\u5d29\u3002\n\n\u6700\u8fd1\u6253\u6a21\u62df\u8d5b\uff0c\u4f1a\u505a\u7684\u9898\u7ecf\u5e38\u505a\u4e0d\u51fa\u6765\u3002\u751a\u81f3\u51e0\u6b21 T1 \u90fd\u505a\u4e0d\u51fa\u6765\uff0c\u5c31\u662f\u90a3\u79cd\u522b\u4eba\u90fd\u5207\u7a7f\u7684\uff0c\u8111\u5b50\u5c31\u662f\u60f3\u4e0d\u51fa\u6765\u3002\n\nNOIP \u522b\u6253\u5d29\u3002\n\n### 2026.10.31\n\n\u5341\u6708\u7684\u6700\u540e\u4e00\u5929\uff0c\u8fdb\u884c\u4e00\u4e2a CSP \u7684\u8003\u8bd5\u3002\n\n\u6628\u5929\u665a\u4e0a\u73a9\u4e86\u4e00\u665a\u4e0a\uff0c\u65e9\u4e0a\u73a9\u4e86\u4e00\u65e9\u4e0a\uff0c\u4e0b\u5348\u5c31\u53bb\u8003\u8bd5\u4e86\u3002\n\n\u55ef\u2026\u2026\u8fd9\u4e2a\u952e\u76d8\u6bd4\u8f83\u96be\u7ef7\uff0c\u5404\u79cd\u6309\u952e\u8f6f\u786c\u7a0b\u5ea6\u90fd\u4e0d\u4e00\u6837\u3002\n\n\u55ef\u2026\u2026\u5f00\u8003 5 min \u540e\u9898\u76ee\u538b\u7f29\u5305\u624d\u53d1\u4e0b\u6765\u3002\n\n\u8bfb\u4e86\u4e00\u904d T1\uff0c\u53d1\u73b0\u662f\u663e\u7136\u7684\uff0c\u4e5f\u61d2\u5f97\u60f3\u522b\u7684\u505a\u6cd5\u4e86\uff0c\u9042\u5199\u4e86\u4e2a\u4e8c\u5206 + ST \u8868\uff0c\u4e8e 14:47 \u505a\u6389\u3002\n\n\u968f\u540e\u5957\u8def\u5316\u5730\u901a\u8bfb\u4e00\u4e0b T2 \u5230 T4\u3002T2 \u628a\u4e00\u4e2a\u5730\u94c1\u7ebf\u8def\u7f29\u6210\u4e00\u4e2a\u70b9\uff0c\u662f\u4e00\u4e2a\u4e8c\u5206\u56fe\u3002T3 \u770b\u7740\u4e0d\u592a\u53ef\u505a\uff0c\u6027\u8d28\u611f\u89c9\u6709\u70b9\u53ef\u505a\u3002T4 \u601d\u8003\u4e86\u4e00\u4e0b\u6ca1\u5565\u592a\u5927\u601d\u8def\u3002\n\n\u5148\u53bb\u5199\u4e86 T2 \u7684\u90e8\u5206\u5206\u3002$O(n(n+m)\\log (n+m))$ \u7684 dijksrta \u662f\u5bb9\u6613\u7684\u3002\u7136\u540e\u53bb\u770b\u4e86 T3\uff0c\u679a\u4e3e\u5de6\u7aef\u70b9\u5bf9\u53f3\u7aef\u70b9\u505a dp\uff0c\u6709\u4e00\u4e2a $O(n^3)$ \u7684 dp\uff0c\u6709 40pts\u3002\u4e0a\u4e2a\u5355\u8c03\u961f\u5217\u4f18\u5316\u5e94\u8be5\u6709 $O(n^2\\log n)$\u3002\u7136\u540e\u628a T4 \u7684\u6307\u6570\u7ea7\u66b4\u529b\u5199\u4e86\uff0c\u6709 15pts\u3002\n\n\u6b64\u65f6\u65f6\u95f4\u624d\u521a 16:00\u3002\u611f\u89c9\u6709\u673a\u4f1a\u51b2\u4e00\u6ce2 WC \u7684\u3002\n\n\u53bb\u505a T2\u3002\u5176\u5b9e\u8003\u540e\u53bb\u770b\uff0cT2 \u6ca1\u6709\u5207\u6389\u5df2\u7ecf\u53ef\u4ee5\u5ba3\u5e03\u6b7b\u4ea1\u4e86\u3002T2 \u601d\u8003\u826f\u4e45\u65e0\u679c\uff0c\u5199\u4e86\u4e00\u4e2a bfs \u53ef\u4ee5\u8fc7 B \u6027\u8d28\u3002\u5e94\u8be5\u6709 84pts\uff0c\u5269\u4e0b 4 \u4e2a\u70b9\u4e0d\u592a\u53ef\u505a\u3002\n\n\u540e\u9762\u5bf9\u4e8e T3 \u5269\u4e0b\u7684\u5206\u4e5f\u6ca1\u6709\u601d\u8def\uff0c\u53bb\u5199 T4 \u4e86\u3002\u679a\u4e3e\u65ad\u8fb9\u5206\u4e24\u90e8\u5206\u5904\u7406\uff0c\u5e76\u679a\u4e3e\u4e24\u8fb9\u7684 $k$\uff0c\u5bf9\u6bcf\u4e2a\u90e8\u5206\u4ece\u76f4\u5f84\u4e2d\u70b9\u5411\u5916 bfs\uff0c\u53ef\u4ee5\u505a\u5230 $O(n^2k\\log n)$\uff0c\u52a0\u4e0a\u8fd9\u4e2a\u5e94\u8be5\u6709 35pts\u3002\u53ef\u662f\u6ca1\u80fd\u8c03\u51fa\u6765\u3002\n\n\u6700\u540e\u5e94\u8be5\u662f 100+84+40+15=239pts\u3002\n\n\u4e0b\u8003\u540e\u548c\u65c1\u8fb9\u7684 gdfz \u7684\u54e5\u4eec\u4ea4\u6d41\uff0c\u88ab\u544a\u77e5 T2 \u53ef\u4ee5\u7528 FLoyd \u76f4\u63a5\u505a\u3002\u5ffd\u7136\u611f\u89c9\u81ea\u5df1\u662f\u5f31\u667a\u3002\u548c\u540c\u5b66\u4ea4\u6d41\uff0c\u53d1\u73b0\u5168\u4e16\u754c\u90fd\u5207\u6389\u4e86 T2\uff0c\u540c\u5b66\u544a\u77e5 T3 B \u6027\u8d28\u5168\u662f $0$\uff0c8pts \u662f\u9001\u7684\u3002\u540e\u6765\u53c8\u544a\u77e5\u6211\u4ed6\u60f3\u5047\u4e86\u3002\n\n\u51fa\u8003\u573a eps \u60f3\u5230 T2 $O(n^3)$ \u7684 Floyd \u505a\u6cd5\u3002\u65e0\u9700\u5efa $n+m$ \u4e2a\u70b9\uff0c\u53ea\u9700\u8981\u5efa $n$ \u4e2a\u70b9\uff0c\u5c06 $m$ \u4e2a\u5730\u94c1\u7ad9\u770b\u6210 $d^2$ \u6761\u8fb9\u5373\u53ef\u3002\n\n\u82e5\u628a T2 \u505a\u6389\uff0c\u5e76\u7528\u8282\u7701\u4e0b\u6765\u7684\u65f6\u95f4\u628a T4 \u8c03\u5b8c\u5e94\u5f53\u6709 275pts\u3002\n\n### 2026.11.02\n\n\u55ef\u2026\u2026\u81ea\u6d4b\u4e0b\u6765\u7591\u4f3c\u786e\u51ff\u662f\u6302\u4e86\u3002\u53ea\u6709100+68+24+15=207pts\u3002T2 \u7684 B \u6027\u8d28\u88ab\u5361\u5e38\u4e86\uff0cT3 \u624b\u6b20\u52a0\u4e86\u4e00\u884c\u5361\u5e38\u4f18\u5316\uff0c\u76f4\u63a5\u7ed9\u5e72 WA \u4e86\uff0c\u5220\u6389\u90a3\u4e00\u884c\u5c31\u6709 40pts\u3002\n\n\u7b97\u662f\u8003\u5d29\u4e86\u5427\u3002\n\n\u4e00\u573a CSP \u800c\u5df2\uff0c\u5176\u5b9e\u6ca1\u5565\u53ef\u5199\u7684\u3002\u8981\u662f\u653e\u5728\u4ee5\u524d\uff0c\u53ef\u80fd\u786e\u5b9e\u4f1a\u7834\u9632\u6216\u53d1\u8868\u4e00\u4e9b\u66b4\u623e\u8bed\u8a00\u3002\u6302\u5206\u5c31\u6302\u5206\u561b\uff0c\u6253\u5d29\u5c31\u6253\u5d29\u561b\uff0c\u5e73\u65f6\u6a21\u62df\u8d5b\u6253\u5d29\u7684\u8fd8\u5c11\u5417\u3002\n\n\u5176\u5b9e\u4f60\u8bf4\uff0c\u6b63\u8d5b\u6253\u5d29\u8fd9\u4e2a\u4e8b\u60c5\uff0c\u4e0d\u53ef\u907f\u514d\u7684\u561b\u3002\u4ece\u80fd\u529b\u4e0a\u53bb\u8bb2\uff0c\u4f1a\u7684\u5206\u81f3\u5c11\u6709 275 \u5427\u3002\u6ca1\u62ff\u5230\u5c31\u53ea\u80fd\u8bf4\u660e\u80fd\u529b\u4e0d\u884c\u3002\n\n\u6211\u65e0\u6cd5\u62ff\u5230\u6211\u80fd\u529b\u4e4b\u5916\u7684\u4e1c\u897f\uff0c\u4e5f\u4e0d\u4f1a\u62ff\u4e0d\u5230\u6211\u80fd\u529b\u4e4b\u5185\u7684\u4e1c\u897f\u3002\u5c31\u7b97\u5076\u7136\u5f97\u5230\u6216\u5931\u53bb\uff0c\u7ec8\u5c06\u4e5f\u4f1a\u5931\u53bb\u6216\u5f97\u5230\u3002\n\nCSP \u8003\u5b8c\u5c31\u8003\u5b8c\u4e86\uff0c\u80fd\u8fdb NOIP \u800c\u8fdb\u4e0d\u4e86 WC \u7684\u5206\u6570\u672c\u8d28\u90fd\u6ca1\u6709\u533a\u522b\u3002\u4eca\u5e74\u8fd9\u4e2a\u5c31\u7b97\u6211\u6253\u4e86 275 \u5e94\u8be5\u4e5f\u8fdb\u4e0d\u4e86 WC\u3002\n\nCSP \u6e38\u8bb0\u6709\u5565\u53ef\u5199\u7684\uff0c\u4e0d\u5c31\u662f\u4e00\u573a\u6a21\u62df\u8d5b\u5417\u3002\u82b1 660 \u5143\u4e70\u4e00\u573a\u6a21\u62df\u8d5b\u3002\n\n---\n\n\u4e0d\u77e5\u9053\u8be5\u5199\u5565\uff0c\u8003\u5b8c\u6ca1\u5565\u611f\u89c9\u3002\u70b8\u4e86\u4e5f\u597d\u60f3\u65e0\u6240\u8c13\u4f3c\u7684\u3002\n\n\u8d85\u901f\u68c0\u6d4b\uff0c\u9053\u8def\u4fee\u590d\uff0c\u5730\u94c1\u3002\u4ece\u6765\u90fd\u505a\u4e0d\u51fa T2\uff0c\u611f\u89c9\u6bd4\u8f83\u5f31\u667a\u3002","contentFull":true,"adminNote":null},"favored":false,"voted":null,"canReply":false,"canEdit":false},"user":null,"time":1794747342.361726}</script>            <script src="https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js" charset="utf-8" defer></script>
