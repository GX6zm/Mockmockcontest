        <script id="lentille-context" type="application/json">{"instance":"main","template":"article.show","status":200,"locale":"zh-CN","data":{"article":{"lid":"y81ojhkb","title":"NOI 2026 \u6e38\u8bb0","category":5,"time":1784872015,"author":{"uid":546441,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/546441.png","name":"white_tiger_yyyy","slogan":"Dust to Dust, Ash to Ash, \u5f7c\u65b9\u3078","badge":null,"isAdmin":false,"isBanned":false,"color":"Red","ccfLevel":9,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/6we7gypp.png"},"upvote":9,"replyCount":10,"favorCount":3,"status":2,"solutionFor":null,"promoteStatus":2,"collection":{"id":228,"name":"NOI 2026 \u6e38\u8bb0"},"content":"# NOI2026 \u6e38\u8bb0\n\n## \u524d\u8a00\n\n\u5c18\u57c3\u843d\u5b9a\uff0c\u662f\u4e2a\u8ba9\u4eba\u5f88\u96be\u4e0d\u6ee1\u610f\u7684\u6210\u7ee9\uff0c\u4f46\u662f\u786e\u5b9e\u66b4\u9732\u51fa\u4e86\u592a\u591a\u95ee\u9898\u554a\u2026\u2026\n\n## Day -1\n\n\u5230\u8fbe cyyz \u4e86\uff0c\u7136\u540e\u53d1\u73b0\u4f4f\u5bbf\u6761\u4ef6\u610f\u5916\u7684\u597d\uff0c\u800c\u4e14\u597d\u7684\u79bb\u8c31\u4e86\uff0c\u751a\u81f3\u8fd8\u6709\u868a\u5e10\u548c\u5927\u91cf\u7684\u6d17\u6f31\u7528\u54c1\uff0c\u8fd9\u771f\u7684\u662f\u90a3\u4e2a\u6c34\u6cd5\u70bc\u94dc\u3001\u6298\u53e0\u95e8\u9501\u4e0a\u5c31\u6253\u4e0d\u5f00\u7684 cyyz \u5417\uff0c\u4ece\u826f\u4e86\uff1f\uff1f\uff1f\n\n\u7136\u540e\u53bb\u4e86\u98df\u5802\u53d1\u73b0\u771f\u4ece\u826f\u4e86\uff0c\u4ee4\u4eba\u5b8c\u5168\u65e0\u6cd5\u5c06\u73b0\u5728\u7684 cyyz \u548c\u5c71\u4e1c\u7701\u96c6\u7684 cyyz \u626f\u4e0a\u5173\u7cfb\uff0c\u5413\u54ed\u4e86\u3002\n\n\u7136\u540e\u7531\u4e8e\u548c\u6211\u4e00\u4e2a\u5bbf\u820d\u7684 $\\color{gold}{tebiezhichu}$\u3001xzz \u662f SN \u5fd7\u613f\u8005\uff0c\u6240\u4ee5\u4e00\u5927\u6279 SN \u5165\u6765\u6211\u4eec\u5bbf\u820d\u62ff\u5fbd\u7ae0\uff0c\u7136\u540e\u6211\u5c31\u8d81\u673a\u6362\u4e86\u4e00\u6ce2\uff08\u8bdd\u8bf4\u4e3a\u4ec0\u4e48\u53ea\u6709\u6211\u7684\u5fbd\u7ae0\u662f\u7b80\u7b14\u753b\u554a\u5582\uff09\uff0c\u665a\u4e0a\u53c8\u627e ZR \u548c HZ \u7684\u540c\u5b66\u6362\u4e86\u4e00\u6ce2\uff0c\u7136\u540e\u53d1\u73b0\u4e86 zyx\uff0c\u4e8e\u662f\u7ed9\u4e86\u4ed6\u5fbd\u7ae0\u3002\n\n\u7136\u540e\u5c31\u662f\u5237\u624b\u673a\u548c\u7761\u89c9\u4e86\u3002\n\n## Day 0\n\n\u65e9\u9910\u4e5f\u5f88\u4e0d\u9519\u3002\n\n\u53c2\u52a0\u5f00\u5e55\u5f0f\uff0c\u7136\u540e\u53d1\u73b0 SN \u5c11\u4e86\u4e00\u4e2a\u4f4d\u7f6e\uff0c\u7136\u540e\u5c31\u5360\u4e86\u4e00\u4e2a SX \u7684\u5ea7\u4f4d\uff0c\u7ed3\u679c SX \u7684\u9009\u624b\u4f3c\u4e4e\u76f4\u63a5\u5750\u5230\u8d35\u5bbe\u5e2d\u4e86\uff0c\u597d\u4e8b\u554a\uff01\uff08\n\n\u4e8e\u662f\u5c31\u6709\u4e86\u5f00\u5e55\u96f7\u51fb\u4e4b\uff1a\n\n\u003E \u5927\u6d77\u554a\uff0c\u4f60\u7684\u5473\u9053\u5c31\u50cf\u6211\u7684**\u7238\u7238\u5988\u5988**\uff01\n\n\u4e4b\u540e\u7684\u5c0f\u5b66\u751f\u8868\u6f14\u4e5f\u662f\u516b\u4ed9\u8fc7\u6d77\uff0c\u5404\u663e\u795e\u901a\u4e86\uff0c\u8fd9\u5c31\u662f NOI \u7684\u5f00\u5e55\u5f0f\u5417\uff1f\n\n\u675c\u7237\u7237\u518d\u6b21\u5949\u732e\u4e86\u4f1f\u5927\u7684\u4f18\uff08chao\uff09\u5f02\uff08feng\uff09\u6f14\uff08guo\uff09\u8bb2\uff08zu\uff09\uff0c\u8868\u8fbe\u4e86\u5e0c\u671b\u638c\u7ba1\u56fd\u8db3\u7684\u5b8f\u4f1f\u5fd7\u5411\uff0c\u53ef\u559c\u53ef\u8d3a\uff0c\u53ef\u559c\u53ef\u8d3a\uff01\u8ba9\u6211\u4eec\u795d\u613f\u4e2d\u56fd\u8db3\u7403\u5728\u4fe1\u606f\u5b66\u7684\u52a0\u6301\u4e0b\u8d70\u5411\u6bd4\u5149\u660e\u66f4\u52a0\u5149\u660e\u7684\u5149\u660e\u7684\u5149\u660e\u7684\u672a\u6765\uff01\uff08\n\n\u4e0b\u5348\u8003\u7b14\u8bd5\uff0c\u8003\u524d\u901f\u901a\u4e86\u4e00\u8fb9\uff0c\u7b2c\u4e00\u904d\u5199\u5b8c\u4e4b\u540e\u89c9\u5f97\u81ea\u5df1\u6ee1\u4e86\uff0c\u7136\u540e\u7b2c\u4e8c\u904d\u53d1\u73b0\u6f0f\u4e86\u9053\u9898\uff0c\u7b2c\u4e09\u904d\u53d1\u73b0\u6709\u9053\u9898\u9519\u4e86\uff08\u57cb\u4e0b\u4f0f\u7b14\uff0c\u4e0e\u672c\u4eba UNR \u5f62\u6210\u9c9c\u660e\u5bf9\u6bd4\uff09\uff0c\u6700\u540e\u4e5f\u662f\u5b89\u7a33\u7684 AK \u4e86\u7b14\u8bd5\u4e86\u3002\n\n\u665a\u4e0a\u7a0d\u5fae\u590d\u4e60\u4e86\u4e00\u4e0b\u677f\u5b50\uff0c\u4e8b\u5b9e\u8bc1\u660e\u6ca1\u5565\u5375\u7528\u3002\n\n## Day 1\n\n\u56e0\u4e3a\u5bc6\u7801\u6761\u4e0b\u53d1\u592a\u5feb\u4e86\u6240\u4ee5\u5ef6\u4e86 5 min\u3002\n\n\u770b\u5230 T1 \u5f88\u5feb\u60f3\u5230\u601d\u8def\uff0c\u4f46\u7a7a\u95f4\u5de8\u5927\uff0c\u540e\u6765\u53d1\u73b0\u53ef\u4ee5\u6eda\u6389 K \u8fd9\u4e00\u7ef4\uff0c\u7ed3\u679c\u7531\u4e8e\u72b6\u6001\u6570\u8bbe\u6210\u4e86 $O(\\sum nm)$ \u5bfc\u81f4\u65f6\u95f4\u590d\u6742\u5ea6\u53d8\u6210\u4e86 $O(\\sum n^2k)$\uff0c\u5bfc\u81f4\u75db\u5931 8 pts\uff0c\u9669\u4e9b\u57cb\u4e0b\u4f0f\u7b14\u3002\n\n2.5h \u5f00\u59cb\u770b T2\uff0c\u5f88\u5feb\u53d1\u73b0\u7b54\u6848\u4e00\u5b9a\u662f\u5bf9\u4e8e $dep\u003Ck$ \u7684\u5f80\u6839\u8d70\uff0c\u5176\u4ed6\u968f\u673a\u8df3\uff0c\u5199\u4e86\u4e2a $O(n^2)$ \u8dd1\u8def\uff0c\u7ed3\u679c\u5b8c\u5168\u6ca1\u60f3\u5230\u53ef\u4ee5\u6dc0\u7c89\u8d28\u3002\u7136\u540e\u548c T3 \u53ae\u6740\uff0c\u60f3\u5230\u53ef\u4ee5\u6bcf\u6b21\u52a0\u4e00\u4e2a\u6570\uff0c\u8fd9\u6837\u5c31\u53ef\u4ee5\u7f29\u5c0f\u4e0d\u5c11\u8303\u56f4\uff0c\u4f46\u6ca1\u60f3\u5230\u53ef\u4ee5\u4e00\u6b21\u6254\u4e00\u5806\uff0c\u5bfc\u81f4\u53ea\u6709 25pts\u3002\n\n\u6700\u7ec8\u5f97\u5206 92+50+25=167pts\uff0c\u7ed3\u679c\u51fa\u8003\u573a\u53d1\u73b0 $\\color{gold}{tebiezhichu}$ \u76f4\u63a5 257 \u4e86\uff0cdyc \u4e5f\u662f 200+\uff0cxzz \u548c 47 \u90fd\u662f 190 \u5de6\u53f3\uff0c\u5c31\u8fde\u5931\u8bef\u8fde\u8fde\u7684 dzb \u4e5f\u6ca1\u6bd4\u6211\u4f4e\u591a\u5c11\uff0c\u6211\u7684\u6210\u7ee9\u5df2\u7ecf\u62c9\u5b8c\u4e86\u3002\n\n\u55b7\u96fe\u74f6\u59d0\u59d0\u5931\u8bef\u4e86\uff0c\u53ef\u60dc\u554a\u2026\u2026\n\n\u5f53\u65f6\u5c31\u89c9\u5f97\u81ea\u5df1\u5b8c\u86cb\u4e86\uff0c\u53ef\u80fd\u8fde\u94dc\u90fd\u6ca1\u4e86\uff0c\u4e0d\u8fc7\u5f97\u4e8f\u662f\u4e24\u5929\uff0c\u6240\u4ee5\u89c9\u5f97\u81ea\u5df1\u8fd8\u662f\u6709\u5e0c\u671b\u7684\uff0c\u6240\u4ee5\u5fc3\u6001\u5f53\u5929\u5185\u4e5f\u5c31\u8c03\u6574\u597d\u4e86\u3002\n\n## Day 1.5\n\n\u7814\u5b66\u62c9\u5b8c\u4e86\uff0c\u4e0d\u5230\u4e03\u70b9\u4e0a\u8f66\u7ed3\u679c\u6d77\u519b\u535a\u7269\u9986\u9152\u5e97\u624d\u5f00\u95e8\uff0c\u5728\u8f66\u4e0a\u5446\u4e86 3.5 h \u624d\u4e0b\u8f66\u3002\u73a9\u7684\u65f6\u5019\u8fd8\u633a\u5f00\u5fc3\u7684\uff0c\u6709\u5927\u6d77\uff0c\u4e8e\u662f\u6211\u5f00\u59cb\u64ad\u653e\uff1a\n\n\u003E \u5927\u6d77\u554a\uff0c\u4f60\u7684\u5473\u9053\u5c31\u50cf\u6211\u7684**\u7238\u7238\u5988\u5988**\uff01\n\n\u6700\u7ec8\u5728\u6211\u6821\u540c\u5b66\u7684\u529d\u8bf4\u4e0b\uff0c\u6211\u505c\u6b62\u4e86\u64ad\u653e\u3002\n\n\u4f46\u662f\u73a9\u7684\u65f6\u95f4\u9876\u591a\u4e5f\u5c31\u534a\u5c0f\u65f6\uff0c\u800c\u6211\u4eec\u4e3a\u4e86\u8fd9\u534a\u5c0f\u65f6\u6d88\u8017\u4e86\u4e94\u516d\u4e2a\u5c0f\u65f6\uff0c\u62c9\u5b8c\u4e86\u3002\n\n\u4e0d\u8fc7 47 \u7684 P \u8bdd\u5730\u4f4d\u5f97\u5230\u4e86 sry \u7684\u8ba4\u53ef\u3002\n\n\u5269\u4e0b\u65f6\u95f4\u7528\u6765\u9893\u5e9f\u3001\u7761\u89c9\u548c\u590d\u4e60\u677f\u5b50\uff08\u8fd8\u5dee\u70b9\u628a\u665a\u996d\u7761\u8fc7\u53bb\u4e86\uff09\u3002\n\n## Day 2\n\nT1 \u4e0d\u662f\u5f88\u597d\u50cf\uff0c\u4f46\u662f\uff0c\u6211\u770b\u5230\u4e86\u4e00\u4e2a\u53eb\u505a $k\u003E5$ \u7684\u4e1c\u897f\u3002\n\n\u6b64\u65f6\uff0c\u4f5c\u4e3a\u4e00\u540d\u641e\u7b11\u6905\u5b50\u7ade\u8d5b\u56e2\u961f\u51fa\u4ea7\u7684\u4f18\u79c0 ~~\u4e71\u641e~~ \u9009\u624b\uff0c\u6211\u610f\u8bc6\u5230\u4e86\u672c\u9898\u4e00\u5b9a\u5b58\u5728\u4e00\u79cd\u5bf9\u4e8e $k$ \u8f83\u5927\u7684\u60c5\u51b5\u6210\u7acb\u7684\u505a\u6cd5\uff01\u7136\u540e\u5c31\u987a\u7406\u6210\u7ae0\u5730\u60f3\u5230\u4e86 $k\\ne 2,3,5$ \u65f6\u5019\u7684\u6d88\u6d88\u4e50\u505a\u6cd5\uff0c\u518d\u7ed3\u5408 $O(kn\\log n)$ \u7684\u66b4\u529b\u901a\u8fc7\u4e86\u8fd9\u9053\u9898\uff0c\u6b64\u65f6\u624d\u8fc7\u4e86 1.5h\u3002\n\n\u7ed3\u679c\u6211\u5728\u505a T2 \u7684\u65f6\u5019\u81ea\u4fe1\u5fc3\u8fc7\u4e8e\u7206\u68da\uff0c\u5bfc\u81f4\u7528\u4e86 2h \u641e\u9519\u4e86\u7ebf\u6027\u8fd8\u539f prufer \u5e8f\u5217\u7684\u65b9\u6cd5\uff0c\u6700\u540e\u53ea\u80fd\u901f\u901a\u4e2a\u66b4\u529b\uff0c\u6700\u540e 100+20+8=128pts \u9057\u61be\u79bb\u573a\u4e86\u3002\n\n\u51fa\u8003\u573a\u5148\u9047\u5230\u4e86 dyc \u548c dzb\uff0c\u524d\u8005\u6ca1\u4e0a 110pts\uff0c\u540e\u8005 144pts\uff08\u5b9e\u5219\u7531\u4e8e pretest \u592a\u62c9\u5b9e\u9645\u4e0a\u53ea\u6709 134pts\uff09\uff0c\u611f\u89c9\u81ea\u5df1\u8fd8\u884c\uff1f\n\n\u7136\u540e\u53d1\u73b0 $\\color{gold}{tebiezhichu}$ 200pts\u2026\u2026\u641e\u7b11\u6905\u5b50\u771f\u8981\u6709\u91d1\u4e86\uff1f\n\n47 \u5927\u4eba\u4e09\u5929\u52a0\u8d77\u6765\u5f97\u6709 450pts \u5de6\u53f3\uff0c47 \u5927\u4eba\u5f3a\u5f3a\uff01\n\nbobo \u95ee\u6211\u4e09\u5929\u603b\u5206\u591a\u5c11\uff0c\u6211\u8bf4 395\uff0c\u7136\u540e\u4ed6\u8bf4\uff0c**\u8bf4\u4e0d\u5b9a\u6709\u94f6\u5462**\u3002\n\n\u7ed3\u679c\u6210\u7ee9\u51fa\u6765\u53d1\u73b0\u94f6\u7ebf\u771f\u7684\u662f 395-\uff0c\u7ed9 bobo \u8dea\u4e86\uff0c\u6211\u548c 397 \u7684 dzb \u53d1\u8a93\u518d\u4e5f\u4e0d\u9a82 bobo \u4e86\u3002\n\n\u665a\u4e0a\u5609\u5e74\u534e xjy \u4e00\u5c55\u6b4c\u5589\uff0c\u8fd8\u5c55\u793a\u4e86\u9ad8\u8d85\u7684\u559d\u6c34\u6280\u672f\uff08\u5728\u95f4\u594f\u559d\u6c34\uff09\u3002\u8fd8\u6709\u8d85\u7ea7\u544a\u767d\u54e5\u3002\n\n\u8e22\u4e86\u8e22\u7403\uff0c\u611f\u89c9\u6280\u672f\u6709\u70b9\u7cd9\u4e86\uff0c\u8fd8\u5f97\u6253\u78e8\u554a\u2026\u2026\n\n\u53d1\u73b0\u641e\u7b11\u6905\u5b50 ABDE \u52a0\u8d77\u6765 1 \u91d1 5 \u94f6\uff0c~~\u8fde\u4e2a\u94dc\u90fd\u62ff\u4e0d\u5230\uff0c\u641e\u7b11\u6905\u5b50\u73b0\u5728\u4e00\u4e2a 8 \u7ea7\u52fe\u90fd\u6ca1\u6709\uff0c\u62c9\u6210\u5565\u4e86\u8bf4\u662f\uff0c\u641e\u7b11\u6905\u5b50\u5b8c\u86cb\u4e86~~\u3002\n\n\u665a\u4e0a\u548c\u540c\u5b66\u5f7b\u591c\u957f\u8c08\uff0c\u7b2c\u4e00\u6b21\u611f\u89c9\u548c\u5fd7\u540c\u9053\u5408\u7684\u540c\u5b66\u4eec\u8bf4\u8bdd\u539f\u6765\u662f\u5982\u6b64\u653e\u677e\u8212\u9002\u7684\u4e00\u4ef6\u4e8b\u554a\u2026\u2026\n\n## Day 3\n\n\u4e0a\u5348\u4e3b\u9898\u6d3b\u52a8\u60ca\u73b0 AK \u4e86 NOI \u7684\u5927\u4f6c zxx \u7684\u6f14\u8bb2\uff0c\u5413\u54ed\u4e86\u3002\n\n47 \u59d0\u59d0\u600e\u4e48\u6210\u6e29\u5dde\u4e2d\u5b66\u7684\u4e86\uff0c\u6b38\u6b38\u6b38\u3002\u8fd8\u6709\u600e\u4e48\u957f\u98ce\u957f\u98ce\u5531\u4e86\u4e24\u904d\u554a\u3002\n\n\u7b2c\u4e00\u6b21\u542c\u4e86\u8702\u9e1f\uff0c\u5f88\u597d\u542c\uff0c\u800c\u4e14\u611f\u89c9\u6211\u4e5f\u80fd\u5531\u3002\n\n\u4e0b\u5348\u95ed\u5e55\u5f0f\uff0c\u675c\u7237\u7237\u5c55\u793a\u4e86\u60ca\u4eba\u7684\u9881\u5956\u80fd\u529b\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u628a\u4e00\u7fa4\u6392\u6392\u961f\u51c6\u5907\u9886\u5956\u7684\u9009\u624b\u76f4\u63a5\u4ece\u5de6\u8fb9\u6254\u5230\u53f3\u8fb9\u3001\u8ffd\u5fc6 IOI2001\uff08\u6211\u5e38\u5e38\u8ffd\u5fc6\u8fc7\u53bb.jpg\uff09\u3001\u5728\u53f0\u4e0a\u7ed9\u9009\u624b\u9881\u5b8c\u5956\u540e\u8e39\u4eba\u5bb6\u4e00\u811a\u7b49\u53cb\u597d\u64cd\u4f5c\u3002\u675c\u7237\u7237\u8fd8\u662f\u592a\u6709\u6d3b\u4e86\uff0c\u7b80\u76f4\u662f NOI \u5f00\u95ed\u5e55\u5f0f\u7684\u7075\u9b42\u554a\u2026\u2026\n\n\u9886\u5956\u7684\u65f6\u5019\u5f88\u6fc0\u52a8\uff0c\u4e0d\u8fc7\u552f\u4e00\u7684\u5f71\u50cf\u8d44\u6599\u62cd\u51fa\u4e86\u767d\u96ea\u832b\u832b\u4e4b\u611f\u3002\n\n\u8fd9\u4e2a\u5973\u4e3b\u6301\u4eba\u62c9\u5b8c\u4e86\uff0c\u6587\u76f2\u6765\u7684\uff0c\u8fd8\u62a2\u53e6\u4e00\u4e2a\u4e3b\u6301\u4eba\u7684\u8bdd\uff0c\u69fd\u70b9\u592a\u591a\u4e86\u3002\u800c\u4e14\u58f0\u97f3\u592a\u5927\uff0c\u9707\u5f97\u4eba\u4e0d\u8212\u670d\uff0c\u5fc3\u60c5\u90fd\u7ed9\u641e\u7cdf\u4e86\u3002\n\n\u95ed\u5e55\u5f0f\u5b8c\u4e4b\u540e\u6025\u901f\u6536\u62fe\u4e1c\u897f\u8d70\u4eba\u4e86\u3002\n\n## \u540e\u8bb0\n\n\u65e0\u8bba\u8fc7\u7a0b\u600e\u4e48\u6837\uff0c\u7ed3\u679c\u662f\u597d\u7684\u5c31\u597d\u3002\n\n\u65e2\u7136\u6709\u94f6\u724c\uff0c\u9ad8\u4e8c\u4f30\u8ba1\u5c31\u4e0d\u4f1a\u518d\u82b1\u4e00\u6574\u5e74\u4e13\u6ce8\u7ade\u8d5b\u4e86\uff0c\u80af\u5b9a\u4f1a\u56de\u4e00\u70b9\u6587\u5316\u8bfe\uff0c\u4ee5\u4fdd\u969c\u6700\u7ec8\u7684\u7ed3\u679c\u5427\u3002\n\n\u5176\u5b9e\u6211\u89c9\u5f97\u6211\u9ad8\u4e8c\u5b8c\u5168\u6709\u53ef\u80fd\u62ff\u91d1\u724c\uff0c\u867d\u7136\u96be\u5ea6\u5f88\u5927\uff0c\u53ef\u80fd\u6027\u5f88\u5c0f\uff0c\u4f46\u662f\u6211\u5f00\u59cb\u76f8\u4fe1\u6211\u81ea\u5df1\u4e86\u3002\n\n\u6211\u7b2c\u4e00\u6b21\u610f\u8bc6\u5230\uff0c\u50cf\u6211\u8fd9\u79cd\u5b8c\u5168\u56e0\u4e3a\u5bf9\u7ade\u8d5b\u7684\u70ed\u7231\u800c\u5f00\u59cb\u5b66\u4e60\uff0c\u5e76\u575a\u6301\u5982\u6b64\u957f\u4e00\u6bb5\u65f6\u95f4\u7684\u4eba\uff0c\u5e76\u6ca1\u6709\u6211\u60f3\u8c61\u7684\u90a3\u4e48\u591a\u554a\u3002\n\n\u65e2\u7136\u6211\u70ed\u7231\u7ade\u8d5b\uff0c\u90a3\u5c31\u8981\u5168\u529b\u4ee5\u8d74\uff0c\u67e5\u6f0f\u8865\u7f3a\uff1b\u65e2\u7136\u6211\u7684\u4eba\u751f\u4e0d\u53ea\u6709\u7ade\u8d5b\uff0c\u90a3\u5c31\u4e0d\u80fd\u653e\u5f03\u6587\u5316\u8bfe\uff0c\u5fc5\u987b\u517c\u987e\u3002\u6211\u53ef\u80fd\u73b0\u5728\u624d\u8ba4\u8bc6\u5230\u8fd9\u4ef6\u4e8b\u5427\u3002","contentFull":true,"adminNote":null},"favored":false,"voted":null,"canReply":false,"canEdit":false},"user":null,"time":1794745824.802697}</script>            <script src="https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js" charset="utf-8" defer></script>
