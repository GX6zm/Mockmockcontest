u60e8\u3002\n\n# Day -6\n\u6ce8\u610f\u5230\u8fd8\u6709 6 \u5929\u5c31\u5f00\u8d5b\u4e86\u3002\u6211\u4eec\u548c 47 \u961f\u4e00\u8d77 vp \u4e86\u4e00\u573a\u3002\n\n\u4e24\u961f\u5145\u5206\u5c55\u73b0\u5b9e(tang)\u529b\uff0c\u6700\u7ec8\u5728\u6fc0\u70c8\u51b3\u6597\uff08\u771f\u7684\u5f88\u6fc0\u70c8\uff09\u540e\u6211\u4eec\u4ee5 1 \u9898\u4f18\u52bf\u9669\u80dc\u3002\n\n# Day 0\n\u5206\u597d\u4e86\u5de5\uff0ctbzc \u8d1f\u8d23\u6570\u5b66\u6784\u9020\uff0c\u6211\u8d1f\u8d23\u4e32\u4e32\u548c\u56fe\u8bba\uff0c\u767d\u864e\u8d1f\u8d23\u6570\u636e\u7ed3\u6784\u3002\u5bf9\u81ea\u5df1\u7684\u677f\u5b50\u80fd\u529b\u5f88\u6709\u81ea\u4fe1\uff0c\u9042\u4e0d\u6253\u5370\u677f\u5b50\u3002\n\n\u6211\u4eec\u961f\u5728\u9644\u8fd1\u7684\u9152\u5e97\u4f4f\u4e86\u4e00\u665a\uff0c\u6211\u665a\u4e0a\u60f3\u52a0\u6025\u5f55\u5236\u4e00\u7248\u7403\u7403\u738b\u56fd\uff0c\u7ed3\u679c\u6210\u4e3a\u4e86\u5e9f\u7a3f\uff0c\u8fd8\u88ab\u786c\u63a7 1h\u3002\n\n\u665a\u4e0a\u5341\u4e00\u70b9\u7761\u89c9\u3002\n\n# Day 0.5\n\n\u65e9\u4e0a\u6536\u62fe\u4e00\u4e0b\u8d76\u5f80\u5de5\u5927\u957f\u5b89\u6821\u533a\uff0c\u8fd9\u5730\u65b9\u5df2\u7ecf\u6765\u8fc7 5 \u6b21\u4e86\uff0c\u6bd4\u8f83\u719f\u6089\uff0c\u4f46\u6ca1\u4e86\u65b0\u9c9c\u611f\u3002\n\n3 \u961f\u6210\u529f\u4f1a\u5e08\uff0c\u9886\u53d6\u80f8\u724c\uff0c\u961f\u670d\u548c\u7269\u8d44\uff0c\u53d1\u73b0 3 \u961f\u8003\u573a\u5206\u5e03\u5728 3 \u5c42\u3002\n\n\u70ed\u8eab\u8d5b\u770b\u5230\u5927\u5bb6\u90fd\u8fc7\u4e86 A \u548c C\uff0c\u9042\u5f00 B\uff08\uff1f\n\n\u79d2\u4e86\u7ed3\u8bba\uff0c\u628a\u9898\u76ee\u4ea4\u7ed9\u767d\u864e\u540e\u548c tbzc \u9762\u79ef\u94c1\u6905\u5b50\u521d\u4e8c\u624b\u5b50 WangNoNo\u3002\u53d1\u73b0\u4ed6\u4eec\u6ca1\u7528\u8fc7 vscode\u3002\uff08\uff1f\uff1f\uff1f\u9042\u8fdb\u884c\u6559\u5b66\u3002\n\n\u56de\u6765\u53d1\u73b0\u767d\u864e\u8fd8\u6ca1\u8fc7 B\uff0c\u9042\u538b\u529b\u540c\u5b66\u3002\n\n\u6211\u4e0a\u673a\u5c1d\u8bd5 B\uff0c\u7531\u4e8e\u6211\u548c\u767d\u864e\u4e0b\u6807\u4e0d\u7edf\u4e00\uff0c\u4e8e\u662f\u5931\u8d25\u3002\n\n\u767d\u864e\u53d1\u73b0\u95ee\u9898\uff0c\u4e8e\u662f\u5c06\u8f93\u51fa\u6539\u4e3a\u6807\u51c6\u7b54\u6848\u76f8\u53cd\u6570\uff08\uff1f\n\n\u7ec8\u4e8e\u8fc7\u4e86 B \u9898\uff0cA \u9898\u987a\u5e26\u8fc7\u4e86\u3002C \u9898\u5728 tbzc \u5403\u4e86\u4e00\u53d1\u7f5a\u65f6\u540e\u8fc7\u4e86\u3002\n\n\u51fa\u6765\u5f00\u5e55\u5f0f\uff0c\u6210\u4e3a\u7f5a\u65f6\u7b2c\u4e8c\u591a\u3002OIer_Auto \u961f\u8363\u83b7\u6b63\u6570\u7b2c 3\u3002\u9664\u4e86 47 \u961f\u4e0d\u4f1a B \u4ee5\u5916\u95ee\u9898\u4e0d\u5927\u3002\n\n# Day 1\n\u5f00\u59cb\u4e86\u3002\u5f00\u573a\u6211\u5f00\u4e86 H \u548c I \u4e24\u9898\uff0c\u57cb\u4f0f\u7b14\u3002\n\ntbzc \u4f1a A \u4e86\uff0c\u767d\u864e\u4f1a\u4e86 B\uff0c\u5f00\u699c\u53d1\u73b0 E \u8fc7\u7a7f\u4e86\u3002\n\n\u628a E \u79d2\u4e86\u540e tbcz \u5199\u8fc7\u4e86 A\u3002\n\n\u767d\u864e\u5199 B\uff0c\u770b\u6837\u5b50\u7ec6\u8282\u6709\u70b9\u591a\uff0c\u5f00\u8c03\u3002\n\n\u770b\u699c\uff0cJ \u548c D \u8fc7\u7a7f\u4e86\uff0c\u4e8e\u662f\u6211\u628a J \u8fc7\u4e86\uff0ctbcz \u628a D \u8fc7\u4e86\u3002\n\n\u548c tbzc \u8ba8\u8bba I\uff0c\u628a I \u4ea4\u7ed9\u4ed6\uff0c\u6211\u53bb\u770b\u770b H\u3002\n\n\u6b64\u65f6\u767d\u864e\u8fd8\u5728 B\uff0c\u4e8e\u662f\u8ba9 tbzc \u4e0a\u673a\u53bb\u5199 I\u3002\u4e00\u53d1\uff0c\u8fd8\u662f\u9996 A\uff01\u6211\u4eec\u6709\u4e86\u4e00\u4e2a\u4e94\u89d2\u661f\u6c14\u7403\uff0c\u6b64\u65f6\u6392\u540d\u6765\u5230 2\u3002\n\n\u767d\u864e\u7ec8\u4e8e\u8fc7\u4e86 B\uff0c\u6b64\u65f6\u6392\u540d\u6765\u5230 5\u3002\n\n\u548c tbzc \u5546\u91cf H \u6709\u679c\uff0c\u9010\u6e10\u53d1\u73b0\u6027\u8d28\uff0c\u7136\u540e\u6839\u53f7\u5206\u6cbb\uff0c\u597d\u50cf\u505a\u5b8c\u4e86\uff1ftbzc \u60f3\u8ba9\u6211\u5199\uff0c\u6211\u8ba9\u4ed6\u53bb\u62a2\u6c14\u7403\u3002\u6211\u548c\u767d\u864e\u5f00 L\uff08\u4e8c\u6218\u8f6c\u6298\u70b9\uff09\u3002\n\ntbzc \u8fc7\u4e86 H\uff0c\u53c8\u62ff\u5230\u4e00\u4e2a\u4e94\u89d2\u661f\u6c14\u7403\uff0c\u4e8e\u662f tbzc \u5f00 G\u3002\n\n\u60f3\u4e86\u60f3 L\uff0c\u6709\u601d\u8def\uff0c\u9042\u5199\uff0c\u7136\u540e\u5403\u7f5a\u65f6\uff0ctbzc \u5199 G\uff0c\u5403\u7f5a\u65f6\u3002\n\nL \u5403\u4e86\u82e5\u5e72\u7f5a\u65f6\uff0ctbzc \u770b\u4e0d\u4e0b\u53bb\u4e86\uff0c\u4e8e\u662f\u4e00\u8d77 L\u3002\n\n\u53c8\u5403\u4e86\u82e5\u5e72\u53d1\u7f5a\u65f6\uff0c\u6b64\u65f6\u6392\u540d\u6765\u5230 19\u3002\n\n\u4e3a\u4e86\u9632\u6b62\u4e00\u6574\u573a\u683d\u5728 L \u4e0a\uff0ctbzc \u8ba9\u767d\u864e\u5f00 C\uff0c\u7136\u540e\u901a\u8fc7\u3002\u6392\u540d\u6765\u5230 10\u3002\n\n\u5927\u5bb6\u4e00\u8d77\u6765 hack\u3002\u73b0\u5728\u6709 L \u548c G \u4e24\u4efd\u4ee3\u7801\u5728\u5047\uff0c\u4f46\u662f\u6ca1\u6709\u5408\u9002\u7684 hack\u3002\n\n\u5c31\u8fd9\u6837\u50f5\u6301\u5230\u7ed3\u675f\uff0c\u6392\u540d\u6765\u5230 17\u3002\n\nOIer_Auto \u961f\u592a\u5f3a\u4e86\uff0c9 \u9898\u7b2c 10\u3002\n\n47 \u961f 7 \u9898\u7b2c 60\uff0c\u4f46\u662f\u8fc7\u4e86 L\uff0c\u9042 %\u3002\n\n# Day 1.5\n\u95ed\u5e55\u5f0f\uff0c\u6709\u4e24\u4e2a\u9996 A\uff0c\u62ff\u4e86\u4e2a\u7eaa\u5ff5\u724c\u3002\n\n\u6253\u661f\u961f\u4e0d\u7ed9\u53d1\u91d1\u724c\uff0c\u6211\u7684\u6c14\u7403\u4e0d\u77e5\u4e3a\u4f55\u840e\u7f29\u4e86\u3002\n\n\u5706\u6ee1\u6536\u5b98\u3002","contentFull":true,"adminNote":null},"favored":false,"voted":null,"canReply":false,"canEdit":false},"user":null,"time":1794746299.425253}</script>            <script src="https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js" charset="utf-8" defer></script>
