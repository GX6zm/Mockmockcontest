        <script id="lentille-context" type="application/json">{"instance":"main","template":"article.show","status":200,"locale":"zh-CN","data":{"article":{"lid":"wij4lwj1","title":"[CSP2026] \u80dc\u8d25\u4e43\u5175\u5bb6\u5e38\u4e8b\uff1f","category":5,"time":1793611351,"author":{"uid":732804,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/732804.png","name":"Zctf1088","slogan":"\u5c31\u50cf\u98de\u7fd4\u5728\u8fbd\u9614\u5929\u7a7a","badge":null,"isAdmin":false,"isBanned":false,"color":"Orange","ccfLevel":7,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/6m17kfx6.webp"},"upvote":5,"replyCount":0,"favorCount":0,"status":2,"solutionFor":null,"promoteStatus":2,"collection":{"id":230,"name":"CSP2026 \u6e38\u8bb0\u5408\u96c6"},"content":"68 \u5206\u5417\uff1f\u6bd4\u8d85\u901f\u68c0\u6d4b\u9ad8\u4e86 28 \u5206\u8bf6\u2014\u2014\n\n\u88ab\u5730\u94c1\u649e\u4e86\u6709\u6d3b\u7740\u7684\u98ce\u9669\u5417\u3002\n\n\u4eca\u5929\u662f 2026 \u5e74 11 \u6708 2 \u65e5\uff0c\u524d\u5929\u4e0b\u5348\u662f CSP2026\u3002\u8d5b\u65f6\u505a\u4e86\u8bb8\u4e45 T2 \u65e0\u679c\uff0c\u5199\u4e86 84\uff0cT3 \u5199\u4e86 40\uff0cT4 \u6ca1\u8c03\u5b8c\uff0c\u53ea\u6709 15\u3002\u8d5b\u540e\u53d1\u73b0 T2 \u4e0d\u96be\uff0c\u6765\u5b66\u6821\u53d1\u73b0 T2 \u88ab\u5207\u7a7f\u4e86\u3002\u54e6\uff0c\u6211\u7684 B \u6027\u8d28\u8fd8\u88ab\u5361\u5e38\u4e86\u3002T3 \u8fd8\u6302\u6210\u4e86 24\uff0c\u624b\u6b20\u591a\u52a0\u4e86\u4e00\u884c\u65e0\u5173\u4ee3\u7801\u3002\n\n\u600e\u4e48\uff0c\u53c8\u662f\u8fd9\u6837\u5417\uff1f\u4e00\u4f17\u201c100\u201d\u4e2d\u4e00\u4e2a\u9c9c\u660e\u7684\u201c68\u201d\u3002\u5475\uff0c\u53c8\u662f\u505a\u4e0d\u51fa\u88ab\u522b\u4eba\u5207\u7a7f\u7684\u9898\u3002\u540c\u5b66\u5728\u8ba8\u8bba\u7684\u65f6\u5019\uff0c\u597d\u50cf\u4e0d\u77e5\u9053\u8be5\u8bf4\u4ec0\u4e48\u3002\n\n\u6211\u600e\u4e48\u5b66\u4e86 4 \u5e74 OI \u4e86\u8fd8\u505a\u4e0d\u51fa\u7eff\u9898\u3002\n\n---\n\n\u4e24\u5e74\u524d\uff0c\u96e8\u5929\u3002\u6dc5\u6dc5\u6ca5\u6ca5\u5730\u4e0b\u7740\u3002\u96e8\u6c34\u843d\u5230\u673a\u623f\u91cc\u662f\u567c\u567c\u556a\u556a\u7684\u952e\u76d8\u58f0\uff0c\u70e6\u5fc3\u3002\u4e0d\u65ad\u5730 RE\uff0cWA\uff0cTLE\u3002\u90a3\u65f6\u5019\u771f\u7684\u662f\u8fde\u6700\u5c0f\u70b9\u8986\u76d6\u8fd9\u4e48\u7b80\u5355\u7684\u4e00\u4e2a\u8d2a\u5fc3\u90fd\u4e0d\u4f1a\u505a\uff0c\u7801\u529b\u5f31\u7684\u79bb\u8c31\uff0c\u66f4\u662f\u5c06 $O(n^2\\log^2n)$ \u7684\u590d\u6742\u5ea6\u7b97\u4e3a $O(n\\log n)$\u3002\u662f\u5427\uff0c\u8d85\u901f\u68c0\u6d4b\u3002\n\n\u003E \u4f60\u8fd9\u5730\u94c1\u662f\u4e0d\u662f\u8d85\u901f\u4e86\u54c7\uff0c\u600e\u4e48\u628a\u6211\u649e\u4e86\u3002\u4eba\u88ab\u5730\u94c1\u649e\u4e86\u662f\u4e0d\u662f\u4f1a\u6b7b\u554a\u3002\u8fd9\u7535\u8111\u5c4f\u5e55\u4e0a\u90fd\u5168\u662f\u7ea2\u7684\u3002\n\n\u6696\u6696\u7684\u9633\u5149\u5728\u7a7a\u6c14\u4e2d\u5f25\u6f2b\uff0c\u6211\u5c31\u7ad9\u5728\u7a97\u6237\u65c1\u8fb9\uff0c\u60f3\u7740\u4e24\u5e74\u524d\u7684\u4e00\u5207\uff0c\u5982\u4eca\u6211\u7ec8\u4e8e\u4e0d\u662f\u5f53\u521d\u90a3\u5e45\u5f31\u7206\u4e86\u7684\u6a21\u6837\u5427\uff0c\u8fd9\u4e00\u8def\u8d70\u6765\u7ecf\u5386\u4e86\u90a3\u4e48\u591a\u8d77\u8d77\u843d\u843d\u3002\n\n\u8fd9\u662f\u6211\u5f85\u4e86\u8bb8\u4e45\u7684\u673a\u623f\uff0c\u6709\u591a\u4e45\u5462\uff0c\u4e45\u5230\u6700\u521d\u5728\u6211\u8eab\u8fb9\u7684\u540c\u5b66\u90fd\u9000\u5f79\u4e86\u6216\u8005\u5df2\u7ecf\u4e0d\u5728\u8fd9\u91cc\u8bad\u7ec3\uff0c\u8eab\u8fb9\u5df2\u7ecf\u90fd\u662f\u540e\u6765\u624d\u8ba4\u8bc6\u7684\u540c\u5b66\u3002\n\n\u4eca\u5929\u662f 2026 \u5e74 10 \u6708 30 \u65e5\uff0c\u660e\u5929\u5c31\u662f CSP \u4e86\u3002\n\n\u53c8\u662f\u4e00\u5e74 CSP\u3002\n\n\u53c8\u662f\u4e00\u5e74\u79cb\u5929\u3002\n\n\u53c8\u662f\u4e00\u9635\u79cb\u98ce\u3002\n\n\u770b\u770b\u697c\u4e0b\u7684\u90a3\u6761\u8def\uff0c\u8def\u4e24\u65c1\u7684\u6a31\u82b1\u6811\u5230\u4e86\u8fd9\u4e2a\u5b63\u8282\uff0c\u53c8\u662f\u88ab\u98ce\u5439\u5f97\u2026\u2026\u8bf4\u6765\u4e5f\u662f\u5947\u5999\uff0c\u6625\u5929\u5927\u5bb6\u4e00\u8d77\u5f00\u82b1\uff0c\u590f\u5929\u4e00\u8d77\u8302\u76db\uff0c\u51ac\u5929\u4e00\u8d77\u51cb\u843d\uff0c\u504f\u504f\u662f\u8fd9\u79cb\u5929\uff0c\u90a3\u6811\u53f6\u5b50\u7ea2\u7684\u7ea2\uff0c\u9ec4\u7684\u9ec4\uff0c\u7eff\u7684\u7eff\u3002\u7eff\u7684\u8fd8\u662f\u90a3\u4e48\u9c9c\u6d3b\uff0c\u751f\u547d\u529b\u65e0\u9650\u5450\u3002\u9ec4\u7684\u53f6\u5b50\u5462\uff1f\u7ea2\u7684\u53f6\u5b50\u662f\u4e0d\u662f\u5df2\u7ecf\u8981\u6b7b\u6389\u4e86\u54c7\uff1f\n\n\u8def\u5bf9\u9762\u697c\u7684\u4f4d\u7f6e\u4fee\u5f97\u597d\uff0c\u4e0d\u4f1a\u6321\u4f4f\u89c6\u91ce\u3002\u4ece\u7a97\u6237\u5411\u5916\u671b\u6709\u5f88\u5927\u4e00\u7247\u7a7a\u65f7\u7684\u533a\u57df\uff0c\u7eff\u5316\u5f88\u597d\uff0c\u5f88\u6e05\u65b0\uff0c\u5e03\u6ee1\u6696\u6696\u7684\u9633\u5149\u3002\u597d\u660e\u4eae\uff0c\u597d\u6e29\u6696\u3002\n\n\u597d\u6e29\u6696\u2026\u2026\n\n---\n\n\u6211\u597d\u51b7\u3002\n\n\u53bb\u5e74\u5206\u660e\u5df2\u7ecf\u6253\u5f97\u5f88\u597d\u4e86\uff0c\u6a21\u62df\u8d5b\u4e5f\u6253\u5f97\u4e0d\u9519\u4e86\uff0c\u6709\u7740\u8f83\u4e3a\u7a33\u5b9a\u7684\u6210\u7ee9\u3002\u5417\uff1f\n\n\u4e3a\u4ec0\u4e48\u6211\u5b66\u4e86 4 \u5e74 OI \u8fd8\u662f\u505a\u4e0d\u51fa\u7eff\u9898\u3002\n\n\u6211\u4e0d\u77e5\u9053\u4eca\u5929\u662f\u54ea\u4e00\u5929\uff0c\u5e94\u8be5\u662f 2026 \u5e74 10 \u6708\u7684\u67d0\u4e00\u5929\u5427\uff0c\u4e5f\u53ef\u80fd\u662f 11 \u6708\u67d0\u4e00\u5929\u3002\u4e5f\u53ef\u80fd\u662f\u6bcf\u4e00\u5929\u5427\u3002\n\n\u597d\u51b7\uff0c\u6d51\u8eab\u90fd\u5728\u53d1\u6296\u3002\u5206\u660e\u51e0\u5929\u524d\u8fd8\u5bf9\u672a\u6765\u5145\u6ee1\u5411\u5f80\uff0c\u5374\u4e00\u6b21\u6b21\u7ed9\u6211\u8fce\u5934\u4e00\u68d2\u3002\u4e00\u7ad6\u5217\u7684 100 \u5206\u53ea\u6709\u6211\u4e00\u4e2a\u4eba\u6ca1\u6709\u505a\u51fa\u6765\u662f\u8fd9\u6837\u5417\uff1f\n\n\u54c8\u54c8\uff0c\u597d\u83dc\u554a\u3002\n\n\u96be\u9053\u6211\u771f\u7684\u662f\u5e9f\u7269\u5417\uff0c\u4e3a\u4ec0\u4e48\u7b80\u5355\u9898\u4e00\u76f4\u505a\u4e0d\u51fa\u6765\u3002\n\n\u4f60\u4ed4\u7ec6\u53bb\u60f3\u554a\uff0c\u7b80\u5355\u9898\u505a\u4e0d\u51fa\u6765\u53c8\u4e0d\u662f\u4e00\u6b21\u4e24\u6b21\u4e86\uff01\u771f\u7684\u662f\u5076\u7136\u5417\uff1f\n\n\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u51b7\u3002\n\n---\n\n\u4eca\u5929\u662f 2026 \u5e74 11 \u6708 2 \u65e5\u3002\n\n\u6211\u5728\u7287\u7287\u91cc\u8fb1\u9a82\u81ea\u5df1\u53d1\u7262\u9a9a\u3002\u6253\u5f00 QQ \u53d1\u73b0\u540c\u5b66\u5728\u8fb1\u9a82\u81ea\u5df1\u53d1\u7262\u9a9a\uff0c\u9042\u5b89\u6170\uff1a\u201c\u80dc\u8d25\u4e43\u5175\u5bb6\u5e38\u4e8b\u3002\u201d\n\n\u6014\u4f4f\u4e86\u3002\u6211\u628a\u6211\u521a\u53d1\u7684\u7287\u7287\u5220\u6389\u4e86\u3002\n\n\u80dc\u8d25\u4e43\u5175\u5bb6\u5e38\u4e8b\uff1f\u6240\u4ee5\u6211\u6a21\u62df\u8d5b\u6253\u7684\u597d\u6216\u4e0d\u597d\uff0cCSP \u6253\u7684\u597d\u6216\u4e0d\u597d\uff0c\u90fd\u5e94\u5f53\u662f\u5e38\u4e8b\uff1f\u7b54\u6848\u662f\u80af\u5b9a\u7684\u54c7\uff01\u6211\u5df2\u7ecf\u544a\u8bc9\u8fc7\u6211\u81ea\u5df1\u65e0\u6570\u6b21\u8fd9\u4e2a\u7ed3\u8bba\u4e86\u54c7\uff01\u4f60\u4e0d\u662f\u5468\u516d\u5468\u5929\u4e24\u5929\u90fd\u6ca1\u6709\u4e3a\u6b64\u96be\u8fc7\u62c5\u5fe7\u5417\uff1f\u4f60\u4e0d\u662f\u5468\u516d\u8003\u5b8c\u5df2\u7ecf\u201c\u770b\u5f00\u4e86\u201d\u5417\uff1f\u5c31\u53ea\u662f\u56e0\u4e3a\u522b\u4eba\u5168\u8fc7\u4e86\u5c31\u4f60\u6ca1\u8fc7\u5417\uff1f\u4f60\u771f\u7684\u5c31\u8fd9\u4e48\u60f3\u8bc1\u660e\u81ea\u5df1\u4e0d\u6bd4\u522b\u4eba\u5f31\u5417\u2014\u2014\u5bf9\u5427\u2026\u2026\n\n\u80dc\u8d25\u4e43\u5175\u5bb6\u5e38\u4e8b\uff0c\u6216\u8bb8\u5427\u3002\n\n\u4e5f\u8bb8\u5927\u795e\u5e76\u4e0d\u4f1a\u5728\u7b80\u5355\u95ee\u9898\u4e0a\u5931\u8d25\uff0c\u53ef\u6211\u53c8\u4e0d\u662f\u5927\u795e\u3002\n\n\u6211\u6210\u4e3a\u4e0d\u4e86\u5927\u795e\u3002\u4e0d\u4f1a\u505a\u5230\u7684\u3002\n\n\u53ef\u662f\u6211\u53ea\u662f\u60f3\u8d62\u4e00\u56de\u3002\n\n---\n\n\u597d\u51b7\u3002\u88f9\u7d27\u8863\u670d\u3002","contentFull":true,"