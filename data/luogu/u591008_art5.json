:\/\/nazo.one-story.cn\/)\n\n\u5b83\u7684[\u653b\u7565](https:\/\/www.luogu.com.cn\/blog\/blog10086001\/nazo-tong-guan-fang-fa-mi-post)\n\n[$\\colorbox{brown}{\\color{pink}\u4e0d\u53ef\u4ee5\uff0c\u603b\u53f8\u4ee4}$](https:\/\/www.luogu.com.cn\/discuss\/525529)\n\n[\u6709\u4e9b\u7f51\u7ad9\u5c31\u662f\u80fd\u7ed9\u4eba\u51fa\u5176\u4e0d\u610f\u7684\u60ca\u559c](https:\/\/vjudge.net\/xia\u0027da\u0027de\u0027wang\u0027zhi)\n\n[\u82b1\u6d3b](https:\/\/www.luogu.com.cn\/paste\/3byg2o4p)\n\n\u8003\u53e4\u65f6\u53d1\u73b022\u5e747\u6708\u4efd\u6572\u4e86\u4e00\u4e2a[\u5de8\u957f\u7684\u4ee3\u7801](https:\/\/www.luogu.com.cn\/paste\/1d4e4bzu)\n\n[\u9a97\u5206\u5bfc\u8bba](https:\/\/cdn.fzoi.top\/upload\/user\/jz20240202\/22092412459151.pdf)\n## \u540d\u4eba\u540d\u8a00\n$1.$ Talk is cheap, show me the code.\n\n\u5e9f\u8bdd\u5c11\u8bf4\uff0c\u653e\u7801\u8fc7\u6765\uff01\n \u2014\u2014\u4e0d\u77e5\u9053\n\n$2.$ \u4eba\u751f\u5982\u6b64\u590d\u6742\uff0c\u673a\u4f1a\u591a\u5f97\u50cf\u7a20\u5bc6\u56fe\uff0c\u6211\u4eec\u6ca1\u7406\u7531\u8ba4\u8f93\u3002\u5c3d\u7ba1\u6211\u4eec\u8d70\u4e0d\u4e86\u6700\u77ed\u8def\uff0c\u4f46\u56fe\u4ecd\u662f\u8fde\u901a\u56fe\uff0cTLE\u4e4b\u524d\uff0c\u6ca1\u6709\u4e00\u4e2a\u8282\u70b9\u53eb\u5931\u8d25\u3002\n\u2014\u2014\u6dfb\u54e5\n\n$3.$ \u5982\u679c\u8111\u5b50\u60f3\u4e0d\u51fa\u6765\uff0c\u90a3\u5c31\u7528\u811a\u6307\u5934\u60f3\u4e00\u60f3\u3002\u2014\u2014sSay\n## \u4e00\u4e9b\u56fe\u7247\n![](https:\/\/imgsa.baidu.com\/forum\/w%3D580\/sign=8912068a1e3853438ccf8729a312b01f\/e51e7ccf3bc79f3d44e411d6b4a1cd11738b29f6.jpg)\n![](https:\/\/s1.ax1x.com\/2020\/08\/05\/arAiP1.gif)\n![](https:\/\/t1.picb.cc\/uploads\/2018\/05\/09\/2hwloe.md.jpg)\n![](https:\/\/s1.ax1x.com\/2018\/04\/04\/C9AddU.gif)\n![](https:\/\/z3.ax1x.com\/2021\/07\/07\/RHbGUH.gif)\n![](https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/b6244rju.png)\n![](https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/usdwie7j.png)\n\n![](https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/qr43knh8.png)\n![](https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/4drnfb7l.png)\n![](https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/6xyubqsi.png)\n\n[\u6536\u8d77\u4e3b\u9875](https:\/\/www.luogu.com.cn\/user\/591008#\u6536~)\n\n[U373454](https:\/\/www.luogu.com.cn\/problem\/U373454)\n\n\u8fde\u70b9\u5668\n\n```cpp\n#include\u003Ccstdio\u003E  \n#include\u003Cwindows.h\u003E    \n#define KEY_DOWN(VK_NONAME) ((GetAsyncKeyState(VK_NONAME) \u0026 0x8000) ? 1:0)   \n#define click mouse_event(MOUSEEVENTF_LEFTDOWN | MOUSEEVENTF_LEFTUP,0,0,0,0)\nlong long N=10000000;\nvoid tj(){\n\tsystem(\u0022cls\u0022);\n\tprintf(\u0022\u8f93\u5165\u901f\u5ea6(win10\u5efa\u8bae10000000\uff0cwin7\u5efa\u8bae1500000;v=10000000\u65f6\uff0cCPS=60\u5de6\u53f3)\uff1a\u0022);\n\tscanf(\u0022%lld \u0022,\u0026N); system(\u0022cls\u0022);\n}\nvoid work(){\n\tint now=0,k=0;bool flag=1; \n\twhile(1){    \n\t\tif(now==1)click;\n\t\tif(KEY_DOWN(\u00271\u0027)\u0026\u0026flag)now=1;   \n\t    if(KEY_DOWN(\u00272\u0027)\u0026\u0026flag)now=0;    \n\t\tif(KEY_DOWN(\u00273\u0027)){flag=0;now=0;}\n\t\tif(KEY_DOWN(\u00274\u0027)){now=0;flag=1;}\n\t\tif(KEY_DOWN(\u00275\u0027))tj();\n        for(long long i=1;i\u003C=N;++i)k=i+1;  \n    }    \n}\nint main(){ \n    printf(\u0022\u63091\u70b9\u51fb\u5de6\u952e\uff0c\u63092\u505c\u6b62\uff0c\u63093\u9501\u5b9a\uff0c\u63094\u89e3\u9501\uff0c\u63095\u8c03\u901f\\n\u0022);  \n    work(); return 0;  \n}\n```"}},"user":null,"time":1794749517.706038}</script>            <script src="https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js" charset="utf-8" defer></script>
