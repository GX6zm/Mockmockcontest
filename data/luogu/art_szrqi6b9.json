\u4ee5\u4e0a 8 \u540d\u9009\u624b\u5747\u5728\u7701\u9009\u540e\u5728 **\u732b\u516d\u5bb6\u957f\u7fa4** \u63a5\u53d7\u4e86\u77ed\u671f\u3001\u52a8\u8361\u3001\u641e\u7b11\u7684\u8bad\u7ec3\u3002\n\n\u575a\u6301\u5353\u8d8a\uff0c\u4e0d\u65ad\u8d85\u8d8a\u3002OIer_Automation \u5728\u5f53\u5e74\u5404\u9879\u6bd4\u8d5b\u4e2d\u7a33\u5b9a\u53d1\u6325\uff0c\u4ece\u672a\u6389\u51fa\u8fc7\u9ad8\u4e2d\u751f\u524d\u4e94\u540d\u3002\u4f5c\u4e3a\u673a\u623f\u73b0\u5f79\u552f\u4e00\u7535\u5b50\u5ba0\u7269\u548c\u552f\u4e00\u7ecf\u8fc7 NOI \u6d17\u793c\u7684\u8001\u5927\u54e5\uff0c\u6bcf\u5929\u4e2d\u5348\u90fd\u8ba4\u771f\u5b66\u4e60\u5404\u7c7b\u77e5\u8bc6\uff0c\u6700\u7ec8\u4ee5 0.91 \u5206\u7684\u5fae\u5f31\u52a3\u52bf\u5728\u7701\u9009\u4e2d\u8d25\u7ed9\u4e86\u7279\u522b\u4e4b\u5904\uff0c\u5145\u5206\u53d1\u626c\u4e86\u641e\u7b11\u6905\u5b50\u521d\u4e2d\u4e00\u5b9a\u5f3a\u4e8e\u9ad8\u4e2d\u7684\u5149\u8363\u4f20\u7edf\u3002\u540c\u65f6\uff0c\u4ed6\u5145\u5206\u7406\u89e3 bobo \u8981\u6c42\u6587\u5316\u8bfe\u4e0e\u7ade\u8d5b\u5e73\u8861\u7684\u8981\u6c42\uff0c\u5728\u671f\u672b\u8003\u8bd5\u4e0e\u4e00\u6b21\u6708\u8003\u4e2d\u6253\u7206\u697c\u4e0b\u6587\u5316\u8bfe\u751f\uff0c\u5f62\u6210\u4e86\u4e0e\u53e6\u5916\u51e0\u4f4d\u9ad8\u4e00\u7fa4\u53cb\u622a\u7136\u4e0d\u540c\u7684\u6001\u52bf\u3002\n\n\u7ee7\u627f\u9769\u547d\u4f20\u7edf\uff0c\u4e89\u505a\u793e\u4f1a\u4e3b\u4e49\u63a5\u73ed\u4eba\u3002\u55b7\u96fe\u74f6\u4f5c\u4e3a\u60f3\u8981\u6390\u6b7b\u81ea\u5df1\u7684\u96ea\u4e43\u5355\u63a8\u4eba\uff0c\u5728\u5317\u4eac\u81ea\u79f0 SAM\uff0c\u4ee5\u53ca\u5728 THUPC \u4e2d\u88ab\u4f7f\u7528\u7535\u8111 AC \u4e86\u4e24\u9053\u9898\u540e\uff0c\u5728\u7701\u9009\u4e2d\u4ecd\u7136\u4fdd\u6301\u4e86\u826f\u597d\u7684\u52bf\u5934\uff0c\u6700\u7ec8\u6210\u4e3a SN \u5973\u961f\uff0c\u7ee7\u627f\u4e86\u641e\u7b11\u6905\u5b50\u5973\u751f\u7684\u5149\u8363\u4f20\u7edf\u3002\u4f46\u5728\u8d5b\u540e\uff0c\u5979\u5e76\u6ca1\u6709\u6536\u5230\u529d\u8bf4\u5979\u4e3b\u52a8\u653e\u5f03\u7701\u9009\u540d\u989d\u7684\u957f\u4fe1\uff0c\u4e5f\u6210\u4e3a\u4e86\u4e00\u4ef6\u61be\u4e8b\u3002\u4f46\u662f SN \u8fd8\u6709\u6ca1\u6709\u73b0\u5f79\u9ad8\u4e2d\u5973\u751f\u8fd9\u4ef6\u4e8b\uff0c\u4ecd\u7136\u6709\u5f85\u5546\u8bae\u3002\n\n\u4f17\u4eba\u7686\u6e05\u6211\u72ec\u6d4a\uff0c\u4f17\u4eba\u7686\u9192\u6211\u72ec\u9189\u3002\u673a\u623f\u6700\u5f3a\u8010\u9f99\u7ade\u4e89\u8005 white_tiger_yyyy \u5728 CSP-S T2 \u4e2d\u5199 int \u7c7b\u578b\u7684\u5feb\u8bfb\uff0c\u5f3a\u52bf\u6302\u5206\u4ece\u800c\u65e0\u7f18\u300a\u8ffd\u5fc6\u300b\u548c\u300a\u767d\u9e1f\u8fc7\u6cb3\u6ee9\u300b\u3002\u5728\u7701\u9009\u4e2d\uff0c\u867d\u7136\u56e0\u4e3a\u4e0d\u77e5\u9053\u4ea4\u4e92\u9898\u7684 freopen \u8981\u52a0\u5230\u54ea\u91cc\u800c\u53d1\u4e86\u534a\u4e2a\u5c0f\u65f6\u7684\u7535\uff0c\u4f46\u4ecd\u7136\u6210\u4e3a\u4e86\u6700\u540e\u4e00\u53ea\u4ece\u70ed\u9505\u4e0a\u4e0b\u6765\u7684\u8682\u8681\u3002\u7701\u9009\u4e4b\u540e\uff0c\u4ed6\u4ecd\u7136\u4fdd\u6301\u7740\u8010\u9f99\u738b\u5019\u9009\u4eba\u7684\u5f3a\u52bf\u52b2\u5934\uff0c\u66f4\u662f\u5c06\u81ea\u5df1 M \u7684\u5c5e\u6027\u53d1\u626c\u5149\u5927\u3002\u4ed6\u540c\u65f6\u5728\u4e00\u756a\u51b2\u52a8\u540e\u5c06\u81ea\u5df1\u7684\u4e2d\u4e8c\u5c0f\u8bf4\u6295\u7a3f\u5230\u4e86\u54e5\u7fa4\uff0c\u8ba9\u6211\u4eec\u795d\u613f\u4ed6\u2463\u7684\u6f02\u4eae\u3002\n\n\u5e08\u5937\u957f\u6280\u4ee5\u5236\u5937\u3002\u5728 NOIP \u4e2d\u81ea\u79f0\u6ca1\u6709\u8fc7\u6389 T1 \u548c T2 \u7684\u7279\u522b\u4e4b\u5904\u4f5c\u4e3a\u53e6\u4e00\u4f4d\u6700\u5f3a\u8010\u9f99\u7ade\u4e89\u8005\uff0c\u5728\u7701\u9009\u4e2d\u867d\u7136\u6ca1\u80fd\u901a\u8fc7 D2T1\uff0c\u4f46\u4ecd\u7136\u901a\u8fc7\u5f3a\u5927\u7684 DS \u6280\u672f\u5728 D2T3 \u4e2d\u780d\u4e0b 40+\uff0c\u540c\u65f6 D1T1 \u4f7f\u7528\u591a\u9879\u5f0f\u79d1\u6280\u628a 100 \u5206\u4f18\u5316\u5230\u4e86 100 \u5206\uff0c\u6700\u7ec8\u5728 NOI \u7684\u664b\u7ea7\u94fe\u6761\u4e0a\u7684\u6bcf\u4e00\u9879\u6bd4\u8d5b\u90fd\u62ff\u4e0b\u4e86\u6905\u5b