        <script id="lentille-context" type="application/json">{"instance":"main","template":"article.show","status":200,"locale":"zh-CN","data":{"article":{"lid":"kjlf4zbn","title":"\u4ece\u592f\u5230\u62c9\u9510\u8bc4\u6240\u6709\u6d3b\u52a8+\u9762\u79ef\u6e38\u8bb0","category":5,"time":1778474968,"author":{"uid":773813,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/773813.png","name":"xzz_cat6","slogan":"1+1!=1\u003C\u003C1 || \u4ece 2025.11.26 \u5f00\u59cb \u4e0d\u53d1\u7287\u7287\uff08\u6ca1\u575a\u6301\u4f4f\uff09 || 2026.1.10\u65e5\u6253\u5361500\u5929","badge":null,"isAdmin":false,"isBanned":false,"color":"Red","ccfLevel":9,"xcpcLevel":0,"background":""},"upvote":45,"replyCount":14,"favorCount":5,"status":2,"solutionFor":null,"promoteStatus":2,"collection":{"id":227,"name":"APIO 2026 \u6e38\u8bb0"},"content":"\u672c\u6587\u5206\u4e3a\u4e09\u5927\u90e8\u5206\uff0c\u4e3b\u7ebf\uff08\u9762\u79ef\uff09\uff0c\u652f\u7ebf\uff08\u6bd4\u8d5b\uff09\uff0c\u4ece\u592f\u5230\u62c9\u9510\u8bc4\u6240\u6709\u6d3b\u52a8\uff0c**\u5982\u82e5\u6211\u9886\u8fc7\u4f60\u7684\u514d\u8d39\u5fbd\u7ae0\uff0c\u8bf7\u5728 NOI \u627e\u6211 qq \u9886\u5fbd\u7ae0**\uff0c\u672c\u4eba\u548c\u6bcf\u4e2a\u6362\u5fbd\u7ae0\u7684\u4eba\u90fd\u52a0\u4e86 qq\u3002\n\n\u672c\u6587\u6587\u7ae0\u5185\u5bb9\u4e30\u5bcc\uff0c\u7ed9\u4e2a\u70b9\u8d5e\u5427\uff0c\u5c31\u5f53\u6211\u6c42\u4f60\u4e86\u3002\n\nNOI \u60f3\u8981\u9762\u79ef\u897f\u5b89 gxyz \u7684\u540c\u5b66\u8bf7\u52a0 qq \u7fa4\uff1a1093149224\u3002\n\n\u6240\u6709\u56fe\u7247\u7a7a\u95f4\u592a\u5927\uff0c\u6d1b\u8c37\u4e0a\u4f20\u4e0d\u4e0a\u53bb\uff0c\u53ef\u4ee5\u53bb[\u535a\u5ba2\u56ed](https:\/\/www.cnblogs.com\/xzz-cat6\/p\/20012646)\u3002\n\n# \u4e3b\u7ebf\n\u4f17\u6240\u5468\u77e5\uff0cAPIO \u8fd9\u4e2a\u6bd4\u8d5b\u5c31\u662f~~\u6c34\u7fa4~~\u9762\u79ef\u5927\u8d5b\uff0c\u6240\u4ee5\u5c06\u4e3b\u7ebf\u8bbe\u4e3a\u9762\u79ef\uff0c\u652f\u7ebf\u8bbe\u4e3a\u6bd4\u8d5b\uff0c\u8fd9\u91cc\u4e0d\u4f1a\u8c08\u8bba\u4efb\u4f55\u5206\u6570\uff0c\u8bf7\u653e\u5fc3\u98df\u7528\u3002\n\n## Day before\n\u53bb\u3001\u7ec8\u4e8e\u53ef\u4ee5\u53bb APIO \u4e86\u3002\u9274\u4e8e\u8ba4\u8bc6\u7684\u4eba\u592a\u5c11\uff0c\u6240\u4ee5\u6ca1\u641e\u5fbd\u7ae0\uff08\u9519\u8bef\u7684\u51b3\u5b9a\uff09\u3002\u897f\u5b89 gxyz \u4e00\u5171\u53bb\u4e86 6 \u4e2a\u4eba\uff0c\u5206\u522b\u662f @OIer_Automation\u3001@UKE_Automation\u3001@xzz_cat6\u3001@white_tiger_yyyy\u3001@No0Chenquanlin\u3001@wangsiqi2010916\uff0c\u53ef\u60dc\u7684\u662f SN E \u961f\u961f\u957f @te_bie_zhi_chu \u4e0d\u53bb\u3002\n\n\u53bb\u4e4b\u524d\u5728\u963f\u65af\u987f\u8981\u4e86\u4e2a tag\uff0c\u5929\u5929\u6c34\u7fa4\uff0c\u5e76\u4e14\u5236\u5b9a\u9762\u79ef\u540d\u5355\uff1a@picha\u3001@PPPxcy\u3001@ARIS2_0\u3001@ax_by_c\u3001@sbno333\u3001@OrangeEye\u3001@Heartquakes\u3002\n\n# Day 5.7\n\u672c\u6765\u662f\u6700\u9002\u5408\u9762\u79ef\u7684\u4e00\u5929\uff0c\u7ed3\u679c\u8981\u548c @UKE_Automation \u6253\u94a2\u56db\uff0c\u6240\u4ee5\u62d6\u4e86\u3002\u51b3\u5b9a\u660e\u5929\u9762\u4e00\u4e9b\u4eba\u3002\n\n# Day 5.8\n\u4e2d\u5348\u8054\u7cfb @ax_by_c \u9762\u79ef\uff0c\u5728\u793c\u5802\u7684\u4e25\u683c\u53f3\u4e0b\u89d2\u3002\u4e24\u4eba\u76f8\u89c1\u751a\u6b22\uff0c\u9042\u804a\u4e86\u4e00\u4e2d\u5348\uff0c\u5728\u8fd9\u671f\u95f4\u8ba4\u8bc6\u4e86 @Neuro_MLE\uff0c\u5e76\u4e14\u62ff\u5230\u4e86\u7b2c\u4e00\u679a\u5fbd\u7ae0\uff0c\u8fd8\u548c\u4e00\u4e2a\u8def\u4eba\u6362\u4e86\u5fbd\u7ae0\u3002\n\n\u8c8c\u4f3c\u662f\u8fd9\u5929\u4e0b\u5348\u5403\u996d\u7684\u65f6\u5019\uff0c\u89c1\u5230\u4e86 @PPPxcy\uff0c\u9042\u8fdb\u884c\u95ee\u5019\u5e76\u62ff\u5230\u4e86\u7b2c\u4e8c\u679a\u5fbd\u7ae0\u3002\n\n\u5f00\u5e55\u5f0f\u89c1\u4e86 @Heartquakes\uff0c\u53ef\u60dc\u6ca1\u6709\u5fbd\u7ae0\u3002\n\n\u665a\u4e0a\u60f3\u53bb\u9762 @picha\uff0c\u5f97\u77e5\u5728\u5916\u9762\uff0c\u9042\u672a\u679c\u3002\n\n\u7761\u89c9\u65f6\u95f4\uff1a23:40\u3002\n\n# Day 5.9\n\u6bd4\u8d5b\u65e5\u65e9\u4e0a\u6ca1\u4ec0\u4e48\u673a\u4f1a\uff0c\u51fa\u8003\u573a\u627e @picha \u548c @PPPxcy \u804a\u5929\uff0c\u7a81\u7136\u6709\u4e2a\u4eba\u67b6\u7740\u6444\u50cf\u673a\u524d\u6765\u91c7\u8bbf\uff0c\u4e8e\u662f\u63a8\u8350 @PPPxcy \u540e\u548c @picha \u5f00\u6da6\u3002\n\n\u4e0b\u5348\u542c\u8bb2\u9898\u7684\u65f6\u5019\u627e\u5230 @Neuro_MLE \u8865\u4e0a\u4e86\u5fbd\u7ae0\uff0c\u548c @wangsiqi2010916 \u6bd4\u5fbd\u7ae0\u4e2a\u6570\u5931\u8d25\u3002\n\n\u98de\u884c\u68cb\u548c\u6597\u5730\u4e3b\u771f\u597d\u73a9\u3002\n\n\u665a\u4e0a\u60f3\u53bb\u9762 @picha\uff0c\u5f97\u77e5\u5728\u5916\u9762\uff0c\u9042\u672a\u679c\u3002\n\n\u6253\u94a2\u56db\uff0c\u7761\u89c9\u65f6\u95f4\uff1a11:00\u3002\n\n# Day 5.10\n\n\u4e0a\u5348\u8bb2\u7684\u90fd\u662f\u5565\uff0c\u4e0d\u7ba1\u4e86\uff0c\u98de\u884c\u68cb+\u6597\u5730\u4e3b\u3002\n\n\u4e2d\u5348\u9762\u4e86 @OrangeEye\uff0c\u89c1\u5230 @picha \u7684\u65f6\u5019\u8981\u4e86\u4e00\u679a\u5fbd\u7ae0\uff0c\u5e76\u8c08\u8bba\u94a2\u56db\u8fdb\u5ea6\u3002\u4e86\u89e3\u5230\u6709\u623f\u95f4\u665a\u4e0a\u5f00 party\u3002\n\n\u4e0b\u5348\u793e\u4f1a\u5b9e\u8df5\u6210\u8d1f\u91cd\u5f92\u6b65\u4e86\uff0c\u5728\u6b64\u671f\u95f4\u5076\u7136\u8ba4\u8bc6\u4e86 @Little_Cart\u3002\n\n\u95ed\u5e55\u5f0f\u524d\u9762\u4e86 @Little_Cart\uff0c\u804a\u4e86\u5f88\u591a\u5173\u4e8e\u7403\u5708\u7684\u4e8b\u60c5\uff0c\u62ff\u5230\u4e86\u5fbd\u7ae0\u3002\n\n\u95ed\u5e55\u5f0f\u7684\u7f51\u597d\u5361\uff0c\u4e8e\u662f\u5728\u5916\u9762\u73bb\u7483\u524d\u7ad9\u7740\uff0c\u78b0\u89c1\u4e86 @MoCaRabbit\uff0c\u9042\u8fdb\u884c\u9762\u79ef\uff0c\u6210\u529f\u62ff\u5230\u5fbd\u7ae0\u3002\u5728\u6b64\u671f\u95f4\u78b0\u89c1\u8def\u8fc7\u7684 @MrPython\uff0c\u53c8\u62ff\u5230\u4e00\u679a\u5fbd\u7ae0\u3002\n\n\u770b\u89c1 @MoCaRabbit \u7684\u624b\u673a\u6ca1\u7535\u4e86\uff0c\u4e8e\u662f\u5e2e\u4ed6\u547c\u53eb @sbno333 \u51fa\u6765\u9762\uff0c\u6210\u529f\u62ff\u5230\u5fbd\u7ae0\uff0c\u6b64\u65f6 @sbno333 \u7684\u624b\u673a\u4e5f\u6ca1\u7535\u4e86\uff0c\u8fd8\u597d\u6211\u5728\u793e\u4f1a\u5b9e\u8df5\u7684\u65f6\u5019\u79df\u5145\u7535\u5b9d\u4e86\u3002\n\n\u8fd9\u65f6\u5019\uff0c\u6211\u9886\u5230\u4e86 8 \u679a\u5fbd\u7ae0\u3002APIO \u7ed3\u675f\u4e86\uff0c\u672c\u6587\u4e5f\u8be5\u7ed3\u675f\u4e86\uff0c\u5417?\n\n# Day 5.10\u665a\n\u6211\u6293\u4f4f\u6700\u540e\u7684\u65f6\u673a\uff0c\u548c\u6bcf\u4e00\u4e2a\u60f3\u6362\u5fbd\u7ae0\u7684\u4eba\u6362\u5fbd\u7ae0\uff0c\u671f\u95f4\u514d\u8d39\u9886\u4e86\u5f88\u591a\u8def\u4eba\u7684\u5fbd\u7ae0\uff0c\u5e76\u4e14\u548c @ARIS2_0 \u9762\u79ef\uff0c\u9886\u5230\u4e86\u5fbd\u7ae0\u3002\u7ec8\u4e8e\u9762\u5b8c\u4e86\u9762\u79ef\u8ba1\u5212\u540d\u5355\uff0c\u6b64\u65f6\u5fbd\u7ae0\u6570\u6765\u5230\u4e86 16 \u679a\u3002\n\n\u7b49\u5230 23 \u70b9\uff0c\u96c6\u5b9d\u697c\u5927\u5385\u6ca1\u4eba\u4e86\uff0c\u9042\u56de\u53bb\u7761\u89c9\uff0c\u4e3b\u7ebf\u6b63\u5f0f\u5b8c\u7ed3\u4e86\uff0c\u5417\uff1f\n\n# Day 5.11\n\n\u665a\u4e0a 0:30 \u5206\uff0c\u4e8b\u60c5\u51fa\u73b0\u8f6c\u673a\uff0c\u4e86\u89e3\u5230 20510 \u5728 ktv\uff0c\u9042\u524d\u5f80\uff0c\u867d\u7136\u4e00\u4e2a\u8ba4\u8bc6\u7684\u90fd\u6ca1\u6709\uff0c\u4f46\u662f\u73a9\u7684\u597d\u5f00\u5fc3\uff0c\u76f8\u4e92\u52a0\u4e86\u597d\u53cb\uff0c\u53c8\u767d\u5ad6\u4e86\u4e00\u4e9b\u5fbd\u7ae0\uff0c\u671f\u95f4 @Little_Cart \u4e5f\u6765\u4e86\uff0c\u6700\u540e\u5408\u5531\u8702\u9e1f\u3002\u7531\u4e8e\u4eba\u592a\u591a\u4e5f\u4e0d\u719f\uff0c\u8fd9\u91cc\u5c31\u4e0d\u5217\u4e3e\u4e86\uff0c\u8be6\u89c1\u4e0b\u56fe\u3002\n\n\u4e0b\u56fe\u4e3a 23 \u70b9\u7684\u5408\u7167\uff0c\u6b64\u65f6\u6211\u8fd8\u6ca1\u6709\u6765\uff0c\u9042\u5728\u53f3\u4e0a\u89d2\u5360\u4f4d\uff1a\n\n\u7761\u89c9\u65f6\u95f4\uff1a2:00\uff0c\u5230\u6b64\uff0c\u4e3b\u7ebf\u6b63\u5f0f\u5b8c\u7ed3\u3002\n\n**\u656c\u8bf7\u671f\u5f85 NOI 2026 \u9762\u57fa\u8bb0**\u3002\n\n# \u652f\u7ebf\n\nwarning\uff1a\u672c\u90e8\u5206\u6709\u5206\u6570\u51fa\u73b0\uff0c\u5982\u6709\u4e0d\u9002\uff0c\u8bf7\u5c3d\u5feb\u8df3\u8f6c\u4e0b\u4e00\u90e8\u5206\u3002\n\n## Day Before\n\nNOIP \u6253\u4e86 196 \u5206\uff0c\u8be2\u95ee\u4e86\u8c37\u6c11\uff0c\u5e94\u8be5\u80fd\u53bb APIO\uff0c\u9042\u5728 APIO \u62a5\u540d\u622a\u81f3\u524d 3 \u65f6\u62a5\u4e0a\u3002\n\n\u8fc7\u4e86\u51e0\u5929\uff0c\u5f97\u77e5\u81ea\u5df1\u62a5\u4e0a\u4e86\u3002SN \u7684\u5206\u6570\u7ebf\u4e3a 146 \u5206\u3002\u503c\u5f97\u6ce8\u610f\uff0c\u672c\u6821\u6709\u521d\u4e00\u5c0f\u670b\u53cb @Stuart220_Chen \u672c\u8eab\u80fd\u62a5\u4e0a\uff0c\u4f46\u662f\u62a5\u540d\u65f6\u5374\u6ca1\u6709\u5728\u3002\n\n## Day 1\n\u6ca1\u5565\u597d\u8bf4\u7684\uff0c\u7528\u7684\u4fdd\u94dc\u6253\u6cd5\uff0c\u5f00\u9898\u987a\u5e8f T3\uff0cT1\uff0cT2\uff0c\u4ee5\u90e8\u5206\u5206\u4e3a\u4e3b\u300235+56+40=131 \u5206\u3002\n\n\u8fdb\u884c\u5609\u5e74\u534e\u6d3b\u52a8\uff0c\u6210\u529f\u62ff\u5230 4 \u679a\u5370\u7ae0\uff0c\u6362\u4e86\u4e2a\u952e\u5e3d\uff0c\u5609\u5e74\u534e\u6253\u94dc\u3002\n\n## Day 2\n\u9881\u5956\u5178\u793c\u9886\u5230\u94dc\u724c\uff0c\u4e0b\u56fe\u4e3a gxyz \u5927\u5408\u7167\u3002\u4ece\u5de6\u5230\u53f3\u4f9d\u6b21\uff1a@white_tiger_yyyy\u3001@UKE_Automation\u3001@xzz_cat6\u3001@OIer_Automation\u3001@wangsiqi2010916\uff0c\u94f6\u94dc\u94dc\u94dc\u94dc\uff1a\n\n\u5230\u6b64\uff0c\u652f\u7ebf\u5b8c\u7ed3\u3002\n\n# \u4ece\u592f\u5230\u62c9\u9510\u8bc4\u6240\u6709\u6d3b\u52a8\n\u7eaf\u4e3b\u89c2\uff0c\u65e0\u5ba2\u89c2\uff0c\u53ef\u4ee5\u5728\u8bc4\u8bba\u533a\u63d0\u5efa\u8bae\u3002\n\n- \u5348\u9910\u4e0e\u665a\u9910\uff1a\u8fd9\u4e2a\u98df\u5802\u662f\u771f\u53ef\u4ee5\uff0c\u996d\u5f88\u597d\u5403\uff0c\u8fd8\u80fd\u514d\u8d39\u5728\u5176\u4ed6\u7a97\u53e3\u52a0\uff0c\u76f8\u6bd4\u4e8e cyyz \u7b97\u662f\u56fd\u5bb4\u7ea7\u522b\u7684\uff0c\u4e3b\u63a8\u70e4\u8089\u996d\u548c\u5170\u5dde\u62c9\u9762\u3002\u6211\u4eec\u897f\u5b89 gxyz \u5b66\u7740\u70b9\u3002**\u5728\u6b64\u7ed9\u5230\u592f**\u3002\n\n- \u65e9\u9910\uff1a\u6807\u51c6\u9152\u5e97\u9910\uff0c\u4e0d\u8fc7\u8fd9\u4e00\u70b9\u5c31\u6bd4 cyyz \u548c gxyz \u597d\u5230\u4e0d\u77e5\u9053\u54ea\u91cc\u53bb\u4e86\uff0c\u867d\u7136\u6709\u70b9\u666e\u901a\uff0c\u4e0d\u8fc7\u4e0d\u5f71\u54cd\u3002\u5efa\u8bae\u6a59\u6c41\u4e0d\u8981\u90a3\u4e48\u51b0\uff0c\u5bb9\u6613\u62c9\u809a\u5b50\u3002**\u5728\u6b64\u7ed9\u5230\u9876\u7ea7**\u3002\n\n- 5.8 \u7684\u8bb2\u8bfe\uff1a\u7b2c\u4e00\u8282\u8bfe\u611f\u89c9\u9009\u7684\u9898\u4e0d\u9519\uff0c\u6709\u542f\u53d1\u6027\uff0c\u8bfe\u7a0b\u4e5f\u4e0d\u662f\u5f88\u8d76\uff0c\u9664\u4e86\u6709\u70b9\u542c\u4e0d\u61c2\u3002**\u7ed9\u5230\u9876\u7ea7**\u3002\u7b2c\u4e8c\u8282\u8bfe\u4e2d\u56fd\u961f\u957f\u5c55\u73b0\u5b9e\u529b\uff0c\u5230\u7b2c\u4e09\u9875\u5c31\u5f00\u59cb\u4e0a\u96be\u5ea6\uff0c\u542c\u4e86\u534a\u8282\u8bfe\u5c31\u7761\u4e86\uff0c**\u5728\u6b64\u7ed9\u5230 NPC**\u3002\u7b2c\u4e09\u8282\u8bfe\u7406\u8bba\u8bfe\uff0c\u611f\u89c9\u6ca1\u5565\u7528\uff0c\u4e5f\u6ca1\u542f\u53d1\uff0c\u8ddf\u5230\u4e24\u4e2a\u5b57\u6bcd\u6811\u5c31\u8ddf\u4e0d\u4e0b\u53bb\u4e86\uff0c**\u5728\u6b64\u7ed9\u5230 NPC**\u3002\u7b2c\u56db\u8282\u8bfe\u6709\u610f\u601d\uff0c\u80fd\u542c\u61c2\uff0c\u4e5f\u6709\u542f\u53d1\uff0c**\u5728\u6b64\u7ed9\u5230\u592f**\u3002\n\n- \u5f00\u5e55\u5f0f\uff1a\u867d\u7136 dzd \u6ca1\u6765\uff0c\u4f46\u662f\u4ee3\u66ff\u81f4\u8f9e\u7684\u4e00\u6837\u6709\u6d3b\uff0c\u4e0d\u8fc7\u4f60\u7ec8\u7a76\u4e0d\u662f\u4ed6\u3002\u8fc7\u7a0b\u6709\u70b9\u65e0\u804a\u4e86\u3002**\u5728\u6b64\u7ed9\u5230\u4eba\u4e0a\u4eba**\u3002\n\n- \u6bd4\u8d5b\uff1a\u8fd9\u73a9\u610f\u771f\u5c31\u770b\u4e3b\u89c2\u4e86\uff0c\u4e0d\u8fc7\u9898\u76ee\u8d28\u91cf\u4e0d\u9519\uff0c\u5f88\u7efc\u5408\uff0c\u5c31\u662f\u6ca1\u6709\u5b57\u7b26\u4e32\u3002**\u5728\u6b64\u7ed9\u5230\u4eba\u4e0a\u4eba**\u3002\n\n- \u5609\u5e74\u534e\uff1a\u6d3b\u52a8\u672c\u8eab\u5f88\u597d\uff0c\u4e0d\u8fc7\u6392\u961f\u65f6\u95f4\u5f88\u591a\uff0c\u5728\u4e00\u8fb9\u770b\u624b\u673a\u4e5f\u4e0d\u9519\u3002**\u5728\u6b64\u7ed9\u5230\u9876\u7ea7**\u3002\n\n- \u793e\u4f1a\u5b9e\u8df5\uff1a\u6539\u540d\u5f92\u6b65\u8d1f\u91cd\u5427\uff0c\u7ed9\u6211\u8bb2\u8fd9\u4e9b\u6709\u5565\u7528\uff0c\u4e0d\u8fc7\u80fd\u73a9\u624b\u673a\u3002**\u5728\u6b64\u7ed9\u5230 NPC**\u3002\n\n- \u95ed\u5e55\u5f0f\uff1a\u7ec8\u4e8e\u7b49\u5230\u4e86 dzd\uff0c\u8bb2\u8bdd\u5f88\u6709\u610f\u601d\uff0c\u7206\u4e86\u5f88\u591a\u5c0f\u70b9\uff0c\u82b1 3000 \u542c\u8bb2\u8bdd\u503c\u4e86\u3002\u8282\u76ee\u4e2a\u4eba\u611f\u89c9\u53ef\u4ee5\uff0c\u4e3b\u6301\u4e00\u770b\u5c31\u662f\u7ec3\u8fc7\uff0c\u4e0d\u50cf\u67d0 cyyz\u3002**\u5728\u6b64\u7ed9\u5230\u592f**\u3002\n\n- APIO\uff1a\u4e0d\u591a\u8bf4\u4ec0\u4e48\uff0c**\u76f4\u63a5\u7ed9\u5230\u592f**\uff0c\u8c01\u6709\u610f\u89c1\uff1f","contentFull":true,"adminNote":null},"favored":false,"voted":null,"canReply":false,"canEdit":false},"user":null,"time":1794746296.909984}</script>            <script src="https://fecdn.luogu.com.cn/columba/loader.20261113-2335.js" charset="utf-8" defer></script>
